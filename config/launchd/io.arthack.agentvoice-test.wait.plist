<?xml version="1.0" encoding="UTF-8"?>
<!-- agentstart-installer-owned: io.arthack.agentvoice-test.wait.v1 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.arthack.agentvoice-test.wait</string>
	<!-- This interim test service uses AgentVoice's public single-workspace server contract. -->
	<key>ProgramArguments</key>
	<array>
		<string>__PROGRAM__</string>
		<string>run</string>
		<string>__TEST_ENTRYPOINT__</string>
		<string>server</string>
		<string>--workspace</string>
		<string>__TEST_WORKSPACE__</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__TEST_CHECKOUT__</string>
	<key>EnvironmentVariables</key>
	<dict>
		<!-- A committed source change makes convergence reload the resident process. -->
		<key>AGENTSTART_SOURCE_REVISION</key>
		<string>__TEST_SOURCE_REVISION__</string>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PATH</key>
		<string>__PATH__</string>
		<key>XDG_STATE_HOME</key>
		<string>__STATE_ROOT__</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<!-- Resident: preserve the isolated test session across process failures and login. -->
	<key>KeepAlive</key>
	<true/>
	<!-- Standard: test callers can be blocked on this runtime. -->
	<key>ProcessType</key>
	<string>Standard</string>
	<key>Umask</key>
	<integer>63</integer>
	<!-- Throttle retries when AgentVoice or its native runtime cannot start. -->
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>__LOG__</string>
	<key>StandardErrorPath</key>
	<string>__LOG__</string>
</dict>
</plist>
