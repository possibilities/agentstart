<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- agentstart-installer-owned: io.arthack.agentusage.observe.v1 -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.arthack.agentusage.observe</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PROGRAM__</string>
		<string>daemon</string>
		<string>run</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PATH</key>
		<string>__PATH__</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<!-- Standard, not Background: balance callers block on observation
	     freshness, and Background QoS is starved first under contention. -->
	<key>ProcessType</key>
	<string>Standard</string>
	<key>Umask</key>
	<integer>63</integer>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>__LOG__</string>
	<key>StandardErrorPath</key>
	<string>__LOG__</string>
</dict>
</plist>
