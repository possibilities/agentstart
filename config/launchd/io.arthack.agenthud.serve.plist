<?xml version="1.0" encoding="UTF-8"?>
<!-- agentstart-installer-owned: io.arthack.agenthud.serve.v1 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.arthack.agenthud.serve</string>
	<!-- AgentHUD owns the editable web server and its fixed portless name. -->
	<key>ProgramArguments</key>
	<array>
		<string>__PROGRAM__</string>
		<string>serve</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PATH</key>
		<string>__PATH__</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<!-- Resident: keep the durable Work view available between visits. -->
	<key>KeepAlive</key>
	<true/>
	<!-- Standard: a person can be watching this local interface. -->
	<key>ProcessType</key>
	<string>Standard</string>
	<key>Umask</key>
	<integer>63</integer>
	<!-- Throttle retries when the HUD or shared portless proxy is unavailable. -->
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>__LOG__</string>
	<key>StandardErrorPath</key>
	<string>__LOG__</string>
</dict>
</plist>
