<?xml version="1.0" encoding="UTF-8"?>
<!-- agentstart-installer-owned: io.arthack.agentlab.serve.v1 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.arthack.agentlab.serve</string>
	<!-- AgentLab builds and serves its cumulative UI and backend together. -->
	<key>ProgramArguments</key>
	<array>
		<string>__PROGRAM__</string>
		<string>serve</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PATH</key>
		<string>__PATH__</string>
		<!-- Preserve the established server-owned feedback database. -->
		<key>AGENTLAB_FEEDBACK_DB_PATH</key>
		<string>__FEEDBACK_DB__</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<!-- Resident: keep the cumulative laboratory available between visits. -->
	<key>KeepAlive</key>
	<true/>
	<!-- Standard: a person can be using the local interface. -->
	<key>ProcessType</key>
	<string>Standard</string>
	<key>Umask</key>
	<integer>63</integer>
	<!-- Throttle retries after a failed build, occupied port, or backend error. -->
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>__LOG__</string>
	<key>StandardErrorPath</key>
	<string>__LOG__</string>
</dict>
</plist>
