setup = ~/code/agentwork

prefix = ctrl+space

harness.claude.command = claude-native
harness.claude.default-model = opus-1m
harness.claude.default-effort = xhigh

harness.codex.command = codex-native
harness.codex.default-model = gpt-5.6-sol
harness.codex.default-effort = high

tray = tray
tray.visible = true
tray.width = 26
tray-slot = agentmux screen --text slot
tray-slot.visible = false
tray-slot.height = 8
workspace-pane = agentmux screen --text workspace
workspace-pane.visible = false
workspace-pane.width = 40
right-tray = agentmux screen --text agent
right-tray.visible = false
right-tray.width = 40
