setup = ~/code/agentwork
prefix = ctrl+space

[harness claude]
command = claude-native
default-model = opus-1m
default-effort = xhigh

[harness codex]
command = codex-native
default-model = gpt-5.6-sol
default-effort = high

[panel left]
command = tray
description = The agent list
needs-agents = true
visible = true
width = 26

[panel drawer]
command = agentmux screen --text drawer
description =
needs-agents = false
visible = false
height = 8

[panel dock]
command = agentmux screen --text dock
description =
needs-agents = false
visible = false
width = 40

[panel right]
command = agentmux screen --text right
description =
needs-agents = false
visible = false
width = 40
