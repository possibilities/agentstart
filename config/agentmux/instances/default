setup = ~/code/agentwork

prefix = ctrl+space

harness.claude.command = claude-native
harness.claude.default-model = opus-1m
harness.claude.default-effort = xhigh

harness.codex.command = codex-native
harness.codex.default-model = gpt-5.6-sol
harness.codex.default-effort = high

tray.command = tray
tray.description = The agent list
tray.visible = true
tray.width = 26

drawer.command = agentmux screen --text drawer
drawer.description =
drawer.visible = false
drawer.height = 8

canvas.command = agentmux screen --text canvas
canvas.description =
canvas.visible = false
canvas.width = 40

rail.command = agentmux screen --text rail
rail.description =
rail.visible = false
rail.width = 40
