#!/bin/bash

set -euo pipefail

[ "$#" -gt 0 ] || {
    printf 'Usage: run-skills-cli command [args...]\n' >&2
    exit 64
}

log=$(mktemp "${TMPDIR:-/tmp}/agentstart-skills.XXXXXX")
trap 'rm -f -- "$log"' EXIT

set +e
"$@" >"$log" 2>&1
status=$?
set -e

[ "$status" -ne 0 ] || exit 0

printf 'AgentStart skills CLI failed; captured output follows.\n' >&2
cat "$log" >&2
exit "$status"
