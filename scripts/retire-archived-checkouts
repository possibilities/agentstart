#!/bin/bash
# Bounded removal of old AgentStart-managed links after source archival.
set -euo pipefail

case "${1:-}" in
    --check | --apply) mode="$1" ;;
    *) printf 'Usage: retire-archived-checkouts --check|--apply\n' >&2; exit 64 ;;
esac
[ "$#" -eq 1 ] || exit 64

code_root="${AGENTSTART_CODE_ROOT:-$HOME/code}"
bin_dir="${AGENTSTART_RETIRED_BIN_DIR:-$HOME/.local/bin}"
config_root="${AGENTSTART_RETIRED_CONFIG_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}}"

# Only links whose target is inside the exact former checkout are ours to
# retire. These names include previously archived projects; private data and
# non-links are not cleanup targets.
names=(
    agentattention agentgrok agenthud agentkeys agentmux agentsounds agentsource
    agentutils agentwork agentsurface agentbrowse agentlaunch agentweb
    agentcollab agentworkplace agentworkplace-site agentlab agentfx
    codex-viewer codex-swap claude-viewer
)
for name in "${names[@]}"; do
    link="$bin_dir/$name"
    [ -e "$link" ] || [ -L "$link" ] || continue
    # The old Codex swap installer published a short executable wrapper, not
    # a symlink. Refuse every other regular file, even under the same name.
    if [ "$name" = codex-swap ] && [ -f "$link" ] && [ ! -L "$link" ]; then
        if [ "$(cat "$link")" = "$(printf '#!/usr/bin/env bash\n# codex-swap-installer-owned:v1\nexec /opt/homebrew/bin/node %s/codex-swap/src/cli/main.ts "$@"' "$code_root")" ]; then
            if [ "$mode" = --apply ]; then
                rm -- "$link"
                printf 'retired exact Codex swap wrapper: %s\n' "$link"
            else
                printf 'would retire exact Codex swap wrapper: %s\n' "$link"
            fi
            continue
        fi
    fi
    if [ ! -L "$link" ]; then
        printf 'preserving independent command: %s\n' "$link"
        continue
    fi
    target=$(readlink "$link")
    case "$target" in
        "$code_root/$name/"*) ;;
        *) printf 'preserving foreign link: %s -> %s\n' "$link" "$target"; continue ;;
    esac
    if [ "$mode" = --apply ]; then
        rm -- "$link"
        printf 'retired command link: %s\n' "$link"
    else
        printf 'would retire command link: %s -> %s\n' "$link" "$target"
    fi
done

link="$config_root/agentmux/instances/default.yaml"
if [ -e "$link" ] || [ -L "$link" ]; then
    [ -L "$link" ] && [ "$(readlink "$link")" = "$code_root/agentstart/config/agentmux/instances/default.yaml" ] || {
        printf 'retire-archived-checkouts: refusing independent Mux config: %s\n' "$link" >&2
        exit 1
    }
    if [ "$mode" = --apply ]; then
        rm -- "$link"
        printf 'retired Mux config link: %s\n' "$link"
    else
        printf 'would retire Mux config link: %s\n' "$link"
    fi
fi
