#!/usr/bin/env python3
"""Converge only AgentStart's declared, credential-free Executor registrations."""

import argparse
import fcntl
import json
import os
from pathlib import Path
import queue
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import threading
import time


ROOT = Path(__file__).resolve().parent.parent
EXECUTOR = "/Applications/Executor.app/Contents/Resources/executor/executor"
OWNER = "agentstart-executor-integrations-v1"
CONFIG_FIELDS = {
    "transport", "command", "args", "cwd", "env", "staticEnv",
    "versionNegotiation", "spawnPerCall", "appServer", "authenticationTemplate",
}
REGISTRY_WRITES = {
    ("mcp", "addServer"), ("coreTools", "integrations", "remove"),
    ("coreTools", "connections", "create"), ("coreTools", "connections", "refresh"),
}
REGISTRY_READS = {("mcp", "getServer"), ("coreTools", "connections", "list")}


class Failure(Exception):
    pass


def expand(value, home):
    if isinstance(value, str):
        return value.replace("${HOME}", str(home))
    if isinstance(value, dict):
        return {key: expand(item, home) for key, item in value.items()}
    if isinstance(value, list):
        return [expand(item, home) for item in value]
    return value


def config(value):
    """Compare behavior, ignoring presentation and equivalent SDK defaults."""
    unknown = set(value) - CONFIG_FIELDS - {"family"}
    if unknown:
        raise Failure("unrecognized MCP configuration fields: " + ", ".join(sorted(unknown)))
    if value.get("transport") != "stdio":
        raise Failure("only declared stdio registrations may be managed")
    auth = value.get("authenticationTemplate", [{"slug": "none", "kind": "none"}])
    if auth != [{"slug": "none", "kind": "none"}]:
        raise Failure("credential-bearing registrations are independently owned")
    env = {**(value.get("env") or {}), **(value.get("staticEnv") or {})}
    return {
        "transport": "stdio", "command": value.get("command"),
        "args": value.get("args") or [], "cwd": value.get("cwd") or None,
        "env": env, "versionNegotiation": value.get("versionNegotiation") or "auto",
        "spawnPerCall": value.get("spawnPerCall") or False,
        "appServer": value.get("appServer") or None,
    }


def load_manifest(path, home, code_root):
    raw = json.loads(path.read_text())
    if set(raw) != {"version", "servers"} or raw["version"] != 1:
        raise Failure("unsupported integration manifest")
    if not isinstance(raw["servers"], list) or not raw["servers"]:
        raise Failure("integration manifest must declare servers")
    servers, names = [], set()
    for entry in expand(raw["servers"], home):
        allowed = CONFIG_FIELDS - {"env", "authenticationTemplate"}
        if set(entry) - allowed - {"slug", "name", "description", "repo", "optional"}:
            raise Failure("unknown integration manifest field")
        slug = entry.get("slug", "")
        if not re.fullmatch(r"[a-z][a-z0-9_]*", slug) or slug in names:
            raise Failure("invalid or duplicate integration slug")
        names.add(slug)
        if not isinstance(entry.get("name"), str) or not entry["name"]:
            raise Failure(f"{slug}: name is required")
        if not isinstance(entry.get("command"), str) or not entry["command"]:
            raise Failure(f"{slug}: command is required")
        if not isinstance(entry.get("args", []), list) or not all(
            isinstance(arg, str) for arg in entry.get("args", [])
        ):
            raise Failure(f"{slug}: args must be strings")
        # This source contains paths/settings only. Credentials stay with the
        # underlying applications or independent Executor connections.
        if set(entry.get("staticEnv", {})) - {"CODEX_HOME"}:
            raise Failure(f"{slug}: credential environment does not belong in this manifest")
        desired = config({key: item for key, item in entry.items() if key in CONFIG_FIELDS})
        repo = entry.get("repo")
        if repo is not None and (not isinstance(repo, str) or not re.fullmatch(r"agent[a-z]+", repo)):
            raise Failure(f"{slug}: invalid fleet checkout name")
        skip = repo is not None and not (code_root / repo).is_dir()
        if entry.get("optional") and shutil.which(entry["command"]) is None:
            skip = True
        registration = {key: value for key, value in entry.items() if key not in {"repo", "optional"}}
        servers.append((slug, registration, desired, skip))
    return servers


class ExecutorMcp:
    """One supported stdio session, including structured execute/resume results."""

    def __init__(self, executable):
        self.executable = executable
        self.sequence = 0
        self.inbox = queue.Queue()

    def __enter__(self):
        self.process = subprocess.Popen(
            [self.executable, "mcp", "--no-artifacts", "--elicitation-mode", "model"],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            text=True, bufsize=1,
        )
        threading.Thread(target=self.read, daemon=True).start()
        try:
            self.request("initialize", {
                "protocolVersion": "2025-06-18", "capabilities": {},
                "clientInfo": {"name": OWNER, "version": "1"},
            })
            self.send({"jsonrpc": "2.0", "method": "notifications/initialized"})
        except BaseException:
            self.__exit__(*sys.exc_info())
            raise
        return self

    def read(self):
        try:
            for line in self.process.stdout:
                try:
                    value = json.loads(line)
                    self.inbox.put(value if isinstance(value, dict) else None)
                except ValueError:
                    self.inbox.put(None)
        finally:
            self.inbox.put(None)

    def send(self, value):
        self.process.stdin.write(json.dumps(value) + "\n")
        self.process.stdin.flush()

    def request(self, method, params):
        self.sequence += 1
        ident = self.sequence
        self.send({"jsonrpc": "2.0", "id": ident, "method": method, "params": params})
        deadline = time.monotonic() + 90
        while True:
            try:
                value = self.inbox.get(timeout=max(0, deadline - time.monotonic()))
            except queue.Empty as error:
                raise Failure("Executor MCP timed out; outcome is unknown, do not blindly retry") from error
            if value is None:
                raise Failure("Executor MCP closed or returned invalid protocol output")
            if value.get("id") == ident and ("result" in value or "error" in value):
                if "error" in value or not isinstance(value.get("result"), dict):
                    raise Failure("Executor MCP request failed; inspect the supported Executor UI")
                return value["result"]
            if "method" in value and "id" in value:
                # No client-side prompt, credential flow, or sampling is part
                # of registry convergence. Model mode returns pauses as data.
                self.send({"jsonrpc": "2.0", "id": value["id"], "error": {
                    "code": -32601, "message": "Installer does not handle client requests",
                }})

    def invoke(self, name, arguments):
        return self.request("tools/call", {"name": name, "arguments": arguments})

    def __exit__(self, kind, value, traceback):
        self.process.stdin.close()
        try:
            self.process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            self.process.terminate()
            try:
                self.process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self.process.kill()
                self.process.wait()
            if kind is None:
                raise Failure("Executor MCP did not close on EOF; its client was stopped")
        finally:
            self.process.stdout.close()
        if kind is None and self.process.returncode:
            raise Failure("Executor MCP exited unsuccessfully")


def api(invoke, path, args, install=False, record=lambda _: None):
    address = "executor." + ".".join(path)
    if tuple(path) not in REGISTRY_READS and not (install and tuple(path) in REGISTRY_WRITES):
        raise Failure(f"{address}: operation is outside this installer mode")
    result = invoke("execute", {"code": f"return await tools[{json.dumps(address)}]({json.dumps(args)});"})
    accepted = False
    while True:
        structured = result.get("structuredContent")
        if not isinstance(structured, dict):
            raise Failure(f"{address}: missing structured execution result")
        if structured.get("status") != "waiting_for_interaction":
            break
        ident = structured.get("executionId")
        if not isinstance(ident, str) or not ident:
            raise Failure(f"{address}: paused without a recoverable execution ID")
        interaction = structured.get("interaction")
        if not isinstance(interaction, dict):
            interaction = {}
        title = "Add an MCP server" if path == ["mcp", "addServer"] else f"Approve {address}?"
        expected_message = title + "\n\nArguments:\n" + json.dumps(args, ensure_ascii=False, indent=2)
        matches = (
            install and not accepted and tuple(path) in REGISTRY_WRITES
            and interaction.get("address") == address and interaction.get("args") == args
            and interaction.get("kind") == "form"
            and interaction.get("requestedSchema") == {"type": "object", "properties": {}}
            and interaction.get("meta") in (None, {})
            and interaction.get("message") == expected_message
        )
        event = {"executionId": ident, "requestedAddress": address,
                 "action": "accept" if matches else "cancel"}
        try:
            # Persist before resuming; never lose the ID when resume fails.
            record({**event, "status": "pending"})
        except OSError as error:
            raise Failure(f"{address}: could not record pending execution {ident}; no approval sent") from error
        try:
            result = invoke("resume", {"executionId": ident, "action": event["action"], "content": "{}"})
        except (Failure, OSError) as error:
            raise Failure(f"{address}: resume outcome unknown for {ident}; inspect before retrying") from error
        record({**event, "status": "resume_returned"})
        if not matches:
            raise Failure(f"{address}: unexpected approval; cancellation requested for {ident}; convergence stopped")
        accepted = True
    envelope = structured.get("result")
    if result.get("isError") or structured.get("status") != "completed" or not isinstance(envelope, dict):
        raise Failure(f"{address}: execution did not complete successfully")
    if envelope.get("ok") is not True or "data" not in envelope:
        # Never echo raw upstream output: registered config may include secrets.
        raise Failure(f"{address}: tool failed; inspect it with the supported Executor UI")
    return envelope["data"]


def record_execution(path, event):
    def validate(info):
        if (not stat.S_ISREG(info.st_mode) or info.st_nlink != 1
                or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o600):
            raise OSError("unsafe execution journal; existing file preserved")

    flags = os.O_WRONLY | os.O_APPEND | os.O_NONBLOCK | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(path, flags | os.O_CREAT | os.O_EXCL, 0o600)
        created = True
    except FileExistsError:
        validate(os.lstat(path))
        fd = os.open(path, flags)
        created = False
    try:
        info = os.fstat(fd)
        if created and stat.S_IMODE(info.st_mode) != 0o600:
            # Undo only the caller's umask on the file just created exclusively.
            os.fchmod(fd, 0o600)
            info = os.fstat(fd)
        validate(info)
        current = os.lstat(path)
        validate(current)
        if (info.st_dev, info.st_ino) != (current.st_dev, current.st_ino):
            raise OSError("execution journal changed during open; preserved")
        with os.fdopen(fd, "a", closefd=False) as file:
            file.write(json.dumps(event) + "\n")
            file.flush()
            os.fsync(file.fileno())
    finally:
        os.close(fd)


def server_state(call, slug):
    record = call(["mcp", "getServer"], {"slug": slug})["integration"]
    if record is None:
        return None, []
    current = config(record["config"])
    connections = call(["coreTools", "connections", "list"], {"integration": slug})["connections"]
    return current, connections


def default_connection(connections):
    matches = [c for c in connections if c["owner"] == "org" and c["name"] == "default"]
    if len(matches) > 1 or (matches and matches[0]["template"] != "none"):
        raise Failure("the default connection is independently authenticated")
    return matches[0] if matches else None


def replaceable(connections):
    return all(c["owner"] == "org" and c["name"] == "default" and c["template"] == "none"
               for c in connections)


def save_receipt(path, records):
    fd, name = tempfile.mkstemp(dir=path.parent, prefix=".executor-integrations.")
    try:
        with os.fdopen(fd, "w") as file:
            json.dump({"owner": OWNER, "servers": records}, file, indent=2)
            file.write("\n")
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def converge(servers, call, records, install, save):
    plan = []
    # Inspect every desired registration before making any catalog change.
    for slug, registration, desired, skip in servers:
        if skip:
            print(f"{slug}: absent optional tool/checkout; skipped")
            continue
        current, connections = server_state(call, slug)
        default = default_connection(connections)
        if current is not None and current != desired:
            if records.get(slug) != current or not replaceable(connections):
                raise Failure(f"{slug}: configuration differs from source and is not an unchanged owned registration; preserved")
        if not install and (current != desired or default is None):
            raise Failure(f"{slug}: integration/connection is missing or differs; run the full installer")
        plan.append((slug, registration, desired, current))

    for slug, registration, desired, previous in plan:
        if not install:
            print(f"{slug}: configuration and default connection verified")
            continue
        # Recheck immediately before mutation, including independently added
        # connections. A serialized install window remains required.
        current, connections = server_state(call, slug)
        if current != previous:
            raise Failure(f"{slug}: configuration changed during convergence; retry")
        if current is not None and current != desired:
            if not replaceable(connections):
                raise Failure(f"{slug}: independent connections appeared; preserved")
            removed = call(["coreTools", "integrations", "remove"], {"slug": slug})
            if removed.get("removed") is not True:
                raise Failure(f"{slug}: owned registration was not removed")
            current = None
        if current is None:
            call(["mcp", "addServer"], registration)
        # Current Executor auto-connects stdio; older versions do not. Never
        # assume addServer is an upsert or create a duplicate default.
        actual, connections = server_state(call, slug)
        if actual != desired:
            raise Failure(f"{slug}: registered configuration does not match source")
        address = {"owner": "org", "name": "default", "integration": slug}
        if default_connection(connections) is None:
            call(["coreTools", "connections", "create"], {**address, "template": "none"})
        refreshed = call(["coreTools", "connections", "refresh"], address)
        health = refreshed.get("lastHealth")
        if not refreshed.get("tools") or (health and health["status"] != "healthy"):
            raise Failure(f"{slug}: tool discovery did not produce a healthy nonempty catalog")
        records[slug] = desired
        save(records)
        print(f"{slug}: converged ({len(refreshed['tools'])} tools)")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group(required=True)
    modes.add_argument("--check", action="store_true", help="print the source plan without contacting Executor")
    modes.add_argument("--verify", action="store_true", help="read and verify installed registrations")
    modes.add_argument("--install", action="store_true", help="converge the owned catalog through Executor's MCP protocol")
    args = parser.parse_args()
    home = Path.home()
    manifest = Path(os.environ.get("AGENTSTART_EXECUTOR_MANIFEST", ROOT / "config/executor/integrations.json"))
    code_root = Path(os.environ.get("AGENTSTART_CODE_ROOT", home / "code"))
    servers = load_manifest(manifest, home, code_root)
    if args.check:
        for slug, registration, _, skip in servers:
            print(f"  {slug}: {registration['command']} {' '.join(registration.get('args', []))}" + (" (absent; skip)" if skip else ""))
        return
    executable = os.environ.get("AGENTSTART_EXECUTOR_BIN", EXECUTOR)
    receipt = Path(os.environ.get("AGENTSTART_EXECUTOR_RECEIPT", home / ".local/share/agentstart/executor-integrations.json"))
    records = {}
    if receipt.exists():
        prior = json.loads(receipt.read_text())
        if prior.get("owner") != OWNER or not isinstance(prior.get("servers"), dict):
            raise Failure("independent Executor receipt file; preserved")
        records = prior["servers"]
    if args.verify:
        with ExecutorMcp(executable) as client:
            call = lambda path, arguments: api(client.invoke, path, arguments)
            converge(servers, call, records, False, lambda _: None)
        return
    receipt.parent.mkdir(parents=True, exist_ok=True)
    with open(str(receipt) + ".lock", "a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise Failure("another AgentStart Executor convergence is active") from error
        journal = Path(str(receipt) + ".executions.jsonl")
        with ExecutorMcp(executable) as client:
            call = lambda path, arguments: api(client.invoke, path, arguments, True,
                                               lambda event: record_execution(journal, event))
            converge(servers, call, records, True, lambda rows: save_receipt(receipt, rows))


if __name__ == "__main__":
    try:
        main()
    except (Failure, ValueError, KeyError, OSError) as error:
        print(f"AgentStart Executor: {error}", file=sys.stderr)
        sys.exit(1)
