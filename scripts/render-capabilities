#!/bin/bash

set -euo pipefail

die() { printf 'AgentStart resources: %s\n' "$*" >&2; exit 1; }
usage() { printf 'Usage: render-capabilities --install|--check\n'; }

[ "$#" -eq 1 ] || { usage >&2; exit 64; }
case "$1" in
    --install) ;;
    --check)
        cat <<'EOF'
  render the fixed private fleet resource set under ~/.local/share/agentstart/resources
  narrow vendor provider-origin guidance to retained Claude/Codex values
  derive and audit Codex invocation policy from portable skill frontmatter
  render one session-only Claude plugin named agent (/agent:<skill>) with the shadcn MCP server
  render and refresh the skills-only Codex plugin agent@agentstart-managed
  persistently disable every agent:<skill> outside managed Codex sessions
  leave retired-path and ambient-link cleanup to the explicit full installer
EOF
        exit 0
        ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 64 ;;
esac

[ "$(uname -s)" = Darwin ] || die "macOS is required"
[ "$(id -u)" -ne 0 ] || die "run as the target user, not root"

script_dir=$(cd -P -- "$(dirname -- "$0")" && pwd)
repo_root=$(cd -P -- "$script_dir/.." && pwd)
template_root="$repo_root/config/resources"
resources_root="${AGENTSTART_RESOURCES_ROOT:-$HOME/.local/share/agentstart/resources}"
skills_root="$resources_root/skills"
invocation_policy_renderer="$script_dir/render-skill-invocation-policy"
claude_plugin_root="$resources_root/claude/agent"
marketplace_root="$resources_root/codex-marketplace"
managed_names="$resources_root/managed-skills.txt"
mcp_servers="$resources_root/mcp-servers.json"

[ -d "$skills_root" ] || die "no synchronized skills at $skills_root"
command -v jq >/dev/null 2>&1 || die "jq is required"
[ -x "$invocation_policy_renderer" ] || die "skill invocation policy renderer is unavailable"
/usr/bin/jq -e '
    (.mcpServers | type == "object") and
    (.mcpServers | keys == ["shadcn"]) and
    .mcpServers.shadcn == {"command":"npx","args":["shadcn@latest","mcp"]}
' "$template_root/mcp-servers.json" >/dev/null \
    || die "the fixed MCP resource must contain only the shadcn stdio server"

mkdir -p "$resources_root/guidance" "$resources_root/claude"
cp "$repo_root/prompts/AGENTS.md" "$resources_root/guidance/AGENTS.md"

# Plannotator's portable upstream guide includes one provider-detection table
# row for every origin its binary knows. Preserve that useful variable contract
# while narrowing the documented values to this fleet's retained harnesses, so
# a vendor refresh cannot re-advertise retired harnesses in installed resources
# or the public field-guide snapshot.
for skill_manifest in "$skills_root"/*/SKILL.md; do
    [ -f "$skill_manifest" ] && [ ! -L "$skill_manifest" ] || continue
    # shellcheck disable=SC2016 # The backticks name a literal documented variable.
    grep -F '| `PLANNOTATOR_ORIGIN` |' "$skill_manifest" >/dev/null || continue
    # shellcheck disable=SC2016 # The backticks name a literal documented variable.
    [ "$(grep -Fc '| `PLANNOTATOR_ORIGIN` |' "$skill_manifest")" -eq 1 ] \
        || die "vendor skill contains duplicate PLANNOTATOR_ORIGIN rows: $skill_manifest"
    skill_mode=$(stat -f '%Lp' "$skill_manifest")
    /usr/bin/awk '
        /^\| `PLANNOTATOR_ORIGIN` \|/ {
            print "| `PLANNOTATOR_ORIGIN` | Override agent-origin detection for the retained fleet harnesses (`claude-code`, `codex`). Set it when launching Plannotator from a wrapper the detection cannot see through. |"
            next
        }
        { print }
    ' \
        "$skill_manifest" >"$skill_manifest.next"
    chmod "$skill_mode" "$skill_manifest.next"
    mv -f -- "$skill_manifest.next" "$skill_manifest"
    printf 'Narrowed provider origins to Claude/Codex in %s.\n' "$skill_manifest"
done

"$invocation_policy_renderer" --install "$skills_root"
next_managed_names="$resources_root/managed-skills.next"
: >"$next_managed_names"
for skill_dir in "$skills_root"/*/; do
    [ -f "$skill_dir/SKILL.md" ] || continue
    skill_dir=${skill_dir%/}
    printf '%s\n' "${skill_dir##*/}" >>"$next_managed_names"
done
LC_ALL=C sort -u "$next_managed_names" -o "$next_managed_names"
[ -s "$next_managed_names" ] || die "the fixed resource set contains no skills"
mv "$next_managed_names" "$managed_names"

render_root=$(mktemp -d "$resources_root/.render.XXXXXX")
trap 'rm -rf -- "$render_root"' EXIT
next_claude="$render_root/claude/agent"
mkdir -p "$next_claude/.claude-plugin"
cp "$template_root/claude-plugin.json" "$next_claude/.claude-plugin/plugin.json"
cp "$template_root/mcp-servers.json" "$next_claude/.mcp.json"
cp -R "$skills_root" "$next_claude/skills"
cp "$template_root/mcp-servers.json" "$render_root/mcp-servers.json"

next_marketplace="$render_root/codex-marketplace"
next_codex="$next_marketplace/plugins/agent"
mkdir -p "$next_codex/.codex-plugin" "$next_marketplace/.agents/plugins"
cp "$template_root/codex-plugin.json" "$next_codex/.codex-plugin/plugin.json"
cp "$template_root/codex-marketplace.json" "$next_marketplace/.agents/plugins/marketplace.json"
cp -R "$skills_root" "$next_codex/skills"

# Rewrite only the disposable Codex copy so generated prompts use qualified
# plugin names. The private canonical skills stay portable.
for skill_dir in "$next_codex/skills"/*/; do
    [ -f "$skill_dir/SKILL.md" ] || continue
    skill_dir=${skill_dir%/}; skill_name=${skill_dir##*/}
    manifest="$skill_dir/agents/openai.yaml"
    [ -f "$manifest" ] || continue
    bare="\$$skill_name"; qualified="\$agent:$skill_name"
    /usr/bin/awk -v bare="$bare" -v qualified="$qualified" '
        /^[[:space:]]*default_prompt:[[:space:]]*/ {
            while ((position = index($0, bare)) > 0) {
                $0 = substr($0, 1, position - 1) qualified substr($0, position + length(bare))
            }
        }
        { print }
    ' "$manifest" >"$manifest.next"
    mv -f -- "$manifest.next" "$manifest"
done

rm -rf -- "$claude_plugin_root" "$marketplace_root"
mkdir -p "$(dirname "$claude_plugin_root")" "$(dirname "$marketplace_root")"
mv "$next_claude" "$claude_plugin_root"
mv "$next_marketplace" "$marketplace_root"
mv "$render_root/mcp-servers.json" "$mcp_servers"

# Disable names before registering refreshed plugin content: a newly added
# skill must never be ambiently visible for even one successful convergence.
"$script_dir/sync-codex-skill-policy" --merge-previous "$managed_names"
codex_bin="${AGENTSTART_CODEX_BIN:-$(command -v codex || true)}"
[ -x "$codex_bin" ] || die "codex is required to install the fleet skill plugin"
"$codex_bin" plugin marketplace add "$marketplace_root" >/dev/null \
    || die "registering the Codex fleet marketplace failed"
"$codex_bin" plugin add agent@agentstart-managed >/dev/null \
    || die "installing the Codex fleet skill plugin failed"
# The refreshed plugin can no longer expose names absent from the new
# inventory. Only now is it safe to prune their persistent disables.
"$script_dir/sync-codex-skill-policy" "$managed_names"

printf 'Rendered fixed fleet resources with %s skills; installed inert Codex plugin agent@agentstart-managed.\n' \
    "$(wc -l <"$managed_names" | tr -d ' ')"
