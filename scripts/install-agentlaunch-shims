#!/bin/bash

set -euo pipefail

die() {
    printf 'AgentStart AgentLaunch shims installer: %s\n' "$*" >&2
    exit 1
}

[ "$#" -eq 0 ] || {
    printf 'Usage: install-agentlaunch-shims\n' >&2
    exit 64
}

[ "$(uname -s)" = Darwin ] || die "macOS is required"
[ "$(id -u)" -ne 0 ] || die "run as the target user, not root"

# Bare `claude` and `codex` become balanced launches. Each shim names
# only the harness; every other token remains native harness input and reaches
# AgentLaunch unchanged. A managed launch carries AGENTLAUNCH_LAUNCH=1 so a
# descendant that resolves the same PATH falls through to the real binary.
# AGENTLAUNCH_SHIM_BYPASS=1 is the explicit operator escape hatch.
shim_dir="$HOME/.local/share/agentlaunch/shims"
script_dir=$(cd -P -- "$(dirname -- "$0")" && pwd)
codex_invocation="$script_dir/codex-invocation"
[ -x "$codex_invocation" ] || die "Codex invocation helper is missing: $codex_invocation"
claude_invocation="$script_dir/claude-invocation"
[ -x "$claude_invocation" ] || die "Claude invocation helper is missing: $claude_invocation"
operator_cli="$script_dir/agentstart"
[ -x "$operator_cli" ] || die "AgentStart config CLI is missing: $operator_cli"
bin_dir="${AGENTSTART_INSTALL_BIN_DIR:-$HOME/.local/bin}"
cli="$bin_dir/agentstart"
cli_marker='# agentstart-installer-owned: agentstart.cli.v1'
if [ -L "$cli" ] || { [ -e "$cli" ] && ! grep -Fxq "$cli_marker" "$cli"; }; then
    die "refusing to replace an independent agentstart command: $cli"
fi

command -v agentlaunch >/dev/null 2>&1 ||
    die "agentlaunch is not on PATH; run ~/code/agentlaunch/scripts/install.sh first"

mkdir -p "$shim_dir"
mkdir -p "$bin_dir"
cli_temp=$(mktemp "$bin_dir/.agentstart.XXXXXX")
trap 'rm -f -- "$cli_temp"' EXIT
{
    printf '#!/bin/bash\n%s\n' "$cli_marker"
    printf 'exec %q "$@"\n' "$operator_cli"
} >"$cli_temp"
chmod 0755 "$cli_temp"
mv -f -- "$cli_temp" "$cli"

for harness in claude codex; do
    # shellcheck disable=SC2016 # Expanded by the generated shim at launch time.
    invocation='exec "$real" "$@"'
    if [ "$harness" = codex ]; then
        # %q safely embeds even a checkout path containing shell metacharacters.
        # shellcheck disable=SC2016 # Expanded by the generated shim at launch time.
        printf -v invocation 'exec %q "$real" "$@"' "$codex_invocation"
    elif [ "$harness" = claude ]; then
        # shellcheck disable=SC2016 # Expanded by the generated shim at launch time.
        printf -v invocation 'exec %q "$real" "$@"' "$claude_invocation"
    fi
    shim="$shim_dir/$harness"
    # apply_patch owns this source file; this heredoc deliberately generates
    # the installed wrappers from one reviewed template.
    cat >"$shim" <<EOF
#!/usr/bin/env bash
# AgentStart-managed AgentLaunch shim: bare \`$harness\` uses the fleet launch
# policy. Managed runtime calls apply authored harness preferences and trust.
# AGENTLAUNCH_SHIM_BYPASS=1 is the manual native-binary escape. Regenerate with
# \`agentstart/scripts/install-agentlaunch-shims\`; do not edit in place.
set -euo pipefail
shim_dir=\$(cd -- "\$(dirname -- "\${BASH_SOURCE[0]}")" && pwd -P)
find_real() {
    local IFS=':' dir
    for dir in \$PATH; do
        [ -n "\$dir" ] || continue
        [ -e "\$dir" ] && [ "\$dir" -ef "\$shim_dir" ] && continue
        if [ -x "\$dir/$harness" ]; then
            printf '%s/$harness\n' "\$dir"
            return 0
        fi
    done
    return 1
}
if [ -n "\${AGENTLAUNCH_SHIM_BYPASS:-}" ]; then
    real=\$(find_real) || { printf 'AgentLaunch shim: no real $harness on PATH\n' >&2; exit 127; }
    exec "\$real" "\$@"
fi
if [ -n "\${AGENTLAUNCH_LAUNCH:-}" ]; then
    real=\$(find_real) || { printf 'AgentLaunch shim: no real $harness on PATH\n' >&2; exit 127; }
    $invocation
fi
exec agentlaunch --x-harness $harness "\$@"
EOF
    chmod 0755 "$shim"
    printf 'Installed shim: %s\n' "$shim"
done

# shellcheck disable=SC2016 # The backticks are display text, not an expansion.
printf 'Shims ready. New shells pick them up through the fleet PATH; current shells need `exec zsh`.\n'
