#!/bin/bash
#
# Install the fleet's launch agents.
#
# Every long-running service in the agent* fleet is defined by a template in
# config/launchd/ and installed from here. The fleet checkouts ship the code;
# this script decides when that code runs. The machine layer keeps its own
# services in its own launchd/ directory. Every service this repository owns
# uses io.arthack.<project>.<verb>; ownership still comes from the exact marker,
# never from the namespace alone.
#
# config/launchd/README.md is the contract: what every service shares, what is
# deliberately per-service, and why.
#
# Rerunnable: each service converges independently, a service whose tool is not
# installed is skipped rather than failed, and a service carrying somebody
# else's ownership marker is refused rather than replaced.

set -euo pipefail

check_only=0
status_only=0
script_dir=$(cd -P -- "$(dirname -- "$0")" && pwd)
repo_root=$(cd -P -- "$script_dir/.." && pwd)
source_dir="$repo_root/config/launchd"

launch_agents_dir="${AGENTSTART_INSTALL_LAUNCH_AGENTS_DIR:-$HOME/Library/LaunchAgents}"
bin_dir="${AGENTSTART_INSTALL_BIN_DIR:-$HOME/.local/bin}"
state_root="${XDG_STATE_HOME:-$HOME/.local/state}"
launchctl_bin="${AGENTSTART_INSTALL_LAUNCHCTL:-launchctl}"
render_temp=""

# Every service in the fleet, in install order:
#   label | tool/program basename | log basename | lifecycle
#
# Labels name the action the service performs. Lifecycle is launchd's execution
# shape: resident jobs use KeepAlive, periodic jobs use an interval, and
# queue-triggered jobs combine a directory trigger with a fallback cadence.
# Every service enters through its tool's one public binary and an explicit
# subcommand; the fleet does not grow parallel *d executables.
SERVICES=(
    "io.arthack.agentstart.watch-config|agentstart|config-watch.log|resident"
    "io.arthack.agentbrain.work|agentbrain|worker.log|resident"
    "io.arthack.agentbrain.share|agentbrain|share.log|resident"
    "io.arthack.agentbrain.doctor|agentbrain|doctor.log|periodic"
    "io.arthack.agentusage.observe|agentusage|observer.log|resident"
    "io.arthack.agentattention.serve|agentattention|server.log|resident"
    "io.arthack.agentscrape.process-queue|agentscrape|queue-processor.log|queue-triggered"
    "io.arthack.agentsource.receive|agentsource|receiver.log|resident"
    "io.arthack.agentsource.notify|agentsource|notifier.log|resident"
    "io.arthack.agentwiki.serve|agentwiki|server.log|resident"
)

# Label replacements that the full installer converges atomically. These are
# old names for services still present, not a graveyard for retired tools: once
# the fleet has converged and the migration is deliberately removed, nothing
# here should remember the previous spelling.
legacy_agentattention_label="com.$(id -un).agentattention"
LABEL_REPLACEMENTS=(
    "io.arthack.agentbrain.work|agentbrain.worker"
    "io.arthack.agentbrain.share|agentbrain.share"
    "io.arthack.agentbrain.doctor|agentbrain.doctor"
    "io.arthack.agentusage.observe|agentusage.observer"
    "io.arthack.agentusage.observe|agentusage.daemon"
    "io.arthack.agentattention.serve|agentattention.server"
    "io.arthack.agentattention.serve|$legacy_agentattention_label"
    "io.arthack.agentscrape.process-queue|agentscrape.queue-processor"
    "io.arthack.agentscrape.process-queue|agentscrape.process-queue"
    "io.arthack.agentsource.receive|agentsource.receiver"
    "io.arthack.agentsource.notify|agentsource.notifier"
    "io.arthack.agentwiki.serve|agentwiki.server"
    "io.arthack.agentwiki.serve|agentwiki.serve"
)

# agentwiki's two loopback origins. Named here rather than left to the CLI's
# defaults so a resident service never moves a port because a default changed.
AGENTWIKI_PORT="${AGENTSTART_INSTALL_AGENTWIKI_PORT:-7777}"
AGENTWIKI_ARTIFACT_PORT="${AGENTSTART_INSTALL_AGENTWIKI_ARTIFACT_PORT:-7778}"

usage() {
    cat <<'EOF'
Usage: scripts/install-launchagents [--install|--check|--status]

Install the fleet's launch agents from config/launchd/.

Options:
  --install  Install or converge every fleet service
  --check    Print the plan without changing the system
  --status   Report installed state, last exit, and log size without changes
EOF
}

die() {
    printf 'AgentStart launch agents: %s\n' "$*" >&2
    exit 1
}

note() {
    printf 'AgentStart launch agents: %s\n' "$*"
}

launchctl_available() {
    [ "$launchctl_bin" != none ] && command -v "$launchctl_bin" >/dev/null 2>&1
}

field() {
    printf '%s' "$1" | cut -d'|' -f"$2"
}

# launchd sources no shell rc file, so PATH has to name every directory the
# services reach: bun's own, our bin directory, then the ordinary system set.
service_path() {
    local bun_dir=""
    if command -v bun >/dev/null 2>&1; then
        bun_dir="$(dirname -- "$(command -v bun)"):"
    fi
    printf '%s%s:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin' \
        "$bun_dir" "$bin_dir"
}

tailnet_address() {
    command -v tailscale >/dev/null 2>&1 || return 0
    tailscale ip -4 2>/dev/null | head -n 1 | grep -E '^[0-9.]+$' || true
}

# A value the operator supplied, or another installer discovered, once. Reading
# it back out of the service we are about to replace is what keeps it from
# being silently dropped on every reinstall — a tailnet bind address is not
# recoverable from anything else on the machine.
preserved_env() {
    local label="$1" key="$2" plist="$launch_agents_dir/$1.plist"
    [ -f "$plist" ] && [ ! -L "$plist" ] || return 0
    command -v plutil >/dev/null 2>&1 || return 0
    plutil -extract "EnvironmentVariables.$key" raw -o - "$plist" 2>/dev/null || true
}

# The same idea for a value that lives in ProgramArguments rather than the
# environment: print the argument following the given flag.
preserved_arg() {
    local label="$1" flag="$2" plist="$launch_agents_dir/$1.plist"
    [ -f "$plist" ] && [ ! -L "$plist" ] || return 0
    command -v plutil >/dev/null 2>&1 || return 0
    plutil -extract ProgramArguments json -o - "$plist" 2>/dev/null |
        /usr/bin/python3 -c '
import json, sys
flag = sys.argv[1]
try:
    args = json.load(sys.stdin)
except Exception:
    sys.exit(0)
if flag in args:
    index = args.index(flag) + 1
    if index < len(args):
        sys.stdout.write(args[index])
' "$flag" || true
}

# Extra tokens for one service, as KEY=VALUE lines. Exit 10 means "this service
# is not installable right now" — a deliberate skip, not a failure.
service_tokens() {
    local label="$1"
    case "$label" in
        io.arthack.agentstart.watch-config)
            printf 'STATE_ROOT=%s\n' "$state_root"
            ;;
        io.arthack.agentbrain.work)
            local session
            if [ -n "${AGENTSTART_INSTALL_AGENTBRAIN_BROWSER_SESSION+set}" ]; then
                session="$AGENTSTART_INSTALL_AGENTBRAIN_BROWSER_SESSION"
            else
                session="$(preserved_env "$label" AGENTSCRAPE_BROWSER_SESSION)"
                [ -n "$session" ] \
                    || session="$(preserved_env "$(replacement_label "$label")" AGENTSCRAPE_BROWSER_SESSION)"
            fi
            # Agentscrape ignores invalid pins and silently falls back to a
            # signed-out session; reject them before replacing the service.
            case "$session" in
                "") ;;
                [![:alnum:]]* | *[!a-zA-Z0-9._-]*)
                    die "invalid Agentbrain browser session: use an alphanumeric first character and only letters, digits, dots, underscores, or hyphens"
                    ;;
            esac
            [ "${#session}" -le 128 ] || die "Agentbrain browser session exceeds 128 characters"
            printf 'AGENTBRAIN_BROWSER_SESSION=%s\n' "$session"
            ;;
        io.arthack.agentbrain.share)
            # Agentbrain's ADR 0017: accepting device shares requires naming the
            # tailnet address, and there is no default. With none supplied and
            # none already installed, the ingress is simply not installed.
            # The address this host answers on inside the tailnet is the one
            # fact no project knows for itself, so it is read from tailscale
            # here. A tailnet that is down at install time is not a reason to
            # fail, and not a reason to withdraw an ingress either: the
            # already-installed address is kept.
            local host
            if [ -n "${AGENTSTART_INSTALL_SHARE_HOST+set}" ]; then
                host="$AGENTSTART_INSTALL_SHARE_HOST"
            else
                host="$(tailnet_address)"
                [ -n "$host" ] || host="$(preserved_arg "$label" --host)"
                [ -n "$host" ] || host="$(preserved_arg "$(replacement_label "$label")" --host)"
            fi
            case "$host" in
                "" | none) return 10 ;;
                # A bind address is the operator's decision to expose a
                # listener, so it is validated before anything is written
                # rather than discovered by a service that starts, is refused
                # by the CLI, and is restarted forever by KeepAlive.
                0.0.0.0 | ::)
                    die "refusing to supervise an any-interface share bind: $host"
                    ;;
                *[![:alnum:].:_-]* | -*)
                    die "refusing unsafe share bind address: $host"
                    ;;
            esac
            printf 'SHARE_HOST=%s\n' "$host"
            ;;
        io.arthack.agentusage.observe)
            # Pinned absolutely: the daemon shells both swap tools, and PATH
            # alone cannot be trusted to reach uv- and nvm-managed binaries.
            printf 'CSWAP_BIN=%s\n' "$(command -v cswap || printf '%s' "$bin_dir/cswap")"
            printf 'CODEX_SWAP_BIN=%s\n' \
                "$(command -v codex-swap || printf '%s' "$bin_dir/codex-swap")"
            ;;
        io.arthack.agentscrape.process-queue)
            # The directory launchd watches. Agentscrape's CLI enqueues into it
            # and the service drains it, so it is shared state rather than
            # service configuration, and it is derived the same way the CLI
            # derives it.
            printf 'QUEUE=%s\n' \
                "${XDG_DATA_HOME:-$HOME/.local/share}/agentscrape/queue"
            ;;
        io.arthack.agentsource.receive)
            printf 'SECRET_FILE=%s\n' \
                "${AGENTSTART_AGENTSOURCE_SECRET_FILE:-$HOME/.config/agentsource/github-webhook-secret}"
            ;;
        io.arthack.agentwiki.serve)
            printf 'PORT=%s\n' "$AGENTWIKI_PORT"
            printf 'ARTIFACT_PORT=%s\n' "$AGENTWIKI_ARTIFACT_PORT"
            ;;
    esac
}

owned_marker() {
    printf 'agentstart-installer-owned: %s.v1' "$1"
}

# Ours, a predecessor's, somebody else's, or absent. Only a stranger is refused.
plist_ownership() {
    local label="$1" plist="$launch_agents_dir/$1.plist"
    [ -e "$plist" ] || { printf 'absent'; return 0; }
    if [ -L "$plist" ]; then printf 'foreign'; return 0; fi
    if grep -Fq "$(owned_marker "$label")" "$plist" 2>/dev/null; then
        printf 'ours'
        return 0
    fi
    # Before this script existed, each fleet checkout installed its own service
    # and stamped its own name. Adopting exactly that marker — same tool, same
    # label, same version — is what centralizing here means; anything else
    # sharing a label is still a stranger and is still refused.
    if grep -Fq "${label%%.*}-installer-owned: $label.v1" "$plist" 2>/dev/null; then
        printf 'adopt'
        return 0
    fi
    printf 'foreign'
}

# Agentattention briefly predated centralized fleet service ownership. Its one
# live predecessor had no ownership marker, so it cannot use the ordinary
# adoption path above. Recognize only that exact, inert plist shape: changing
# any key, argument, path, or owner leaves it foreign and therefore refused.
# This migration entry can disappear after every machine has converged.
legacy_replacement_ownership() {
    local new_label="$1" old_label="$2" plist owner
    plist="$launch_agents_dir/$old_label.plist"

    if [ "$new_label" != io.arthack.agentattention.serve ] ||
        [ "$old_label" != "$legacy_agentattention_label" ]; then
        printf 'foreign'
        return 0
    fi
    [ -f "$plist" ] && [ ! -L "$plist" ] || {
        printf 'foreign'
        return 0
    }
    owner="$(stat -f %u "$plist" 2>/dev/null || stat -c %u "$plist" 2>/dev/null || true)"
    [ "$owner" = "$(id -u)" ] || {
        printf 'foreign'
        return 0
    }

    if /usr/bin/python3 - "$plist" "$HOME" "$old_label" <<'PYTHON'
import plistlib
import sys

path, home, label = sys.argv[1:]
with open(path, "rb") as handle:
    actual = plistlib.load(handle)

expected = {
    "Label": label,
    "ProgramArguments": [
        "/opt/homebrew/bin/bun",
        f"{home}/code/agentattention/src/cli.ts",
        "serve",
        "--config",
        f"{home}/.config/agentattention/config.json",
    ],
    "RunAtLoad": True,
    "KeepAlive": True,
    "ThrottleInterval": 5,
    "StandardOutPath": f"{home}/.local/state/agentattention/daemon.log",
    "StandardErrorPath": f"{home}/.local/state/agentattention/daemon.error.log",
}
raise SystemExit(0 if actual == expected else 1)
PYTHON
    then
        printf 'adopt'
    else
        printf 'foreign'
    fi
}

replacement_labels() {
    local new_label="$1" replacement
    for replacement in "${LABEL_REPLACEMENTS[@]}"; do
        if [ "$(field "$replacement" 1)" = "$new_label" ]; then
            field "$replacement" 2
        fi
    done
}

replacement_label() {
    replacement_labels "$1" | sed -n '1p'
}

render_plist() {
    local label="$1" program="$2" log="$3" destination="$4" tokens="$5"
    local source="$source_dir/$label.plist"
    [ -s "$source" ] || die "missing template: $source"

    # The temporary file lives in the destination directory so the publishing
    # rename stays on one filesystem. Cleanup hangs off EXIT rather than RETURN
    # because every failure path here ends the script rather than returning.
    render_temp="$(mktemp "$launch_agents_dir/.$label.plist.XXXXXX")"
    trap 'rm -f -- "$render_temp"' EXIT
    local temp="$render_temp"

    AGENTSTART_RENDER_TOKENS="$(
        printf 'PROGRAM=%s\nHOME=%s\nPATH=%s\nLOG=%s\n' \
            "$program" "$HOME" "$(service_path)" "$log"
        printf '%s' "$tokens"
    )" /usr/bin/python3 - "$source" "$temp" <<'PYTHON' ||
import os
import re
import sys
from xml.sax.saxutils import quoteattr

source, destination = sys.argv[1], sys.argv[2]

values = {}
for line in os.environ["AGENTSTART_RENDER_TOKENS"].split("\n"):
    if not line:
        continue
    key, _, value = line.partition("=")
    values[key] = value

with open(source, encoding="utf-8") as handle:
    rendered = handle.read()

for key, value in values.items():
    # quoteattr escapes for XML and wraps in quotes; the plist supplies its own
    # element, so strip the wrapping and keep the escaping.
    rendered = rendered.replace(f"__{key}__", quoteattr(value)[1:-1])

leftover = re.search(r"__[A-Z0-9_]+__", rendered)
if leftover is not None:
    sys.exit(f"unrendered token {leftover.group(0)} in {source}")

with open(destination, "w", encoding="utf-8") as handle:
    handle.write(rendered)
PYTHON
        die "failed to render $label"

    chmod 600 "$temp"
    if command -v plutil >/dev/null 2>&1; then
        plutil -lint "$temp" >/dev/null || die "rendered an invalid plist for $label"
    fi
    mv -f -- "$temp" "$destination"
    render_temp=""
    trap - EXIT
}

# Reload rather than restart-in-place: launchd caches the plist it bootstrapped,
# so a rewritten file does nothing until the label is booted out and back in.
reload_service() {
    local label="$1" plist="$2" old_labels="$3"
    launchctl_available || {
        note "installed $label (launchctl unavailable; not loaded)"
        return 0
    }
    local target
    target="gui/$(id -u)/$label"
    if "$launchctl_bin" print "$target" >/dev/null 2>&1; then
        "$launchctl_bin" bootout "$target" >/dev/null 2>&1 || true
        local waited=0
        while "$launchctl_bin" print "$target" >/dev/null 2>&1 && [ "$waited" -lt 30 ]; do
            sleep 0.2
            waited=$((waited + 1))
        done
    fi
    local old_label old_target old_plist old_ownership
    while IFS= read -r old_label; do
        [ -n "$old_label" ] || continue
        old_target="gui/$(id -u)/$old_label"
        old_plist="$launch_agents_dir/$old_label.plist"
        old_ownership="$(plist_ownership "$old_label")"
        if [ "$old_ownership" = foreign ]; then
            old_ownership="$(legacy_replacement_ownership "$label" "$old_label")"
        fi
        { [ "$old_ownership" = ours ] || [ "$old_ownership" = adopt ]; } || continue
        if "$launchctl_bin" print "$old_target" >/dev/null 2>&1; then
            "$launchctl_bin" bootout "$old_target" >/dev/null 2>&1 ||
                die "failed to stop replaced service $old_label"
        fi
    done <<EOF
$old_labels
EOF
    "$launchctl_bin" bootstrap "gui/$(id -u)" "$plist" >/dev/null 2>&1 ||
        {
            # Preserve service availability if launchd rejects the replacement.
            # Old plists are removed only after the new label is live.
            while IFS= read -r old_label; do
                [ -n "$old_label" ] || continue
                old_plist="$launch_agents_dir/$old_label.plist"
                [ -f "$old_plist" ] || continue
                "$launchctl_bin" bootstrap "gui/$(id -u)" "$old_plist" >/dev/null 2>&1 || true
            done <<EOF
$old_labels
EOF
            die "failed to load $label; inspect: launchctl print $target"
        }
    while IFS= read -r old_label; do
        [ -n "$old_label" ] || continue
        old_plist="$launch_agents_dir/$old_label.plist"
        [ -f "$old_plist" ] || continue
        rm -- "$old_plist"
        note "replaced $old_label with $label"
    done <<EOF
$old_labels
EOF
    note "installed and loaded $label"
}

install_service() {
    local entry="$1"
    local label tool log_name lifecycle
    label="$(field "$entry" 1)"
    tool="$(field "$entry" 2)"
    log_name="$(field "$entry" 3)"
    lifecycle="$(field "$entry" 4)"

    local program="$bin_dir/$tool"
    local log="$state_root/$tool/$log_name"
    local destination="$launch_agents_dir/$label.plist"

    # A tool that is not installed has no service. This mirrors the rest of the
    # installer: a missing optional fleet checkout is a skip, never an error.
    if [ ! -x "$program" ]; then
        note "skipped $label (no $program)"
        return 0
    fi

    local ownership
    ownership="$(plist_ownership "$label")"
    local old_label old_ownership old_labels owned_old_labels=""
    old_labels="$(replacement_labels "$label")"
    while IFS= read -r old_label; do
        [ -n "$old_label" ] || continue
        old_ownership="$(plist_ownership "$old_label")"
        if [ "$old_ownership" = foreign ]; then
            old_ownership="$(legacy_replacement_ownership "$label" "$old_label")"
        fi
        [ "$old_ownership" != foreign ] ||
            die "refusing to replace a legacy service this installer does not own: $launch_agents_dir/$old_label.plist"
        if [ "$old_ownership" = ours ] || [ "$old_ownership" = adopt ]; then
            owned_old_labels="${owned_old_labels}${owned_old_labels:+
}$old_label"
        fi
    done <<EOF
$old_labels
EOF

    local tokens status=0
    tokens="$(service_tokens "$label")" || status=$?
    if [ "$status" -eq 10 ]; then
        if [ "$check_only" -eq 1 ]; then
            printf '  %-20s %s\n' "$label" "not configured; would skip"
        else
            note "skipped $label (not configured)"
        fi
        return 0
    fi
    [ "$status" -eq 0 ] || die "could not resolve values for $label"

    if [ "$check_only" -eq 1 ]; then
        local plan
        case "$ownership" in
            absent) plan="install" ;;
            ours) plan="converge" ;;
            adopt) plan="adopt from ${label%%.*}" ;;
            foreign) plan="REFUSE — not ours to replace" ;;
        esac
        if [ -n "$owned_old_labels" ]; then
            plan="replace $(printf '%s' "$owned_old_labels" | tr '\n' ',')"
        fi
        printf '  %-28s %-18s %-22s %s\n' "$label" "$lifecycle" "$plan" "$program"
        return 0
    fi

    if [ "$ownership" = foreign ]; then
        die "refusing to replace a service this installer does not own: $destination"
    fi
    if [ "$ownership" = adopt ]; then
        note "adopting $label from ${label%%.*}"
    fi

    mkdir -p "$(dirname -- "$log")"
    [ -e "$log" ] || : >"$log"
    chmod 600 "$log"
    render_plist "$label" "$program" "$log" "$destination" "$tokens"
    reload_service "$label" "$destination" "$owned_old_labels"
}

# Agentweb is retired, but a previously installed broker may still be loaded.
# The plist marker is the sole authority: without that exact marker, neither
# the job nor its file belongs to this installer and both are preserved.
retire_agentweb_broker() {
    local label=agentweb.broker
    local marker='agentstart-installer-owned: agentweb.broker.v1'
    local plist="$launch_agents_dir/$label.plist"
    local target
    target="gui/$(id -u)/$label"

    if [ ! -e "$plist" ] && [ ! -L "$plist" ]; then
        if [ "$check_only" -eq 1 ]; then
            printf '  %-28s %-18s %s\n' "$label" retired 'absent; nothing to remove'
        fi
        return 0
    fi

    if [ -L "$plist" ] || [ ! -f "$plist" ] ||
        ! grep -Fqx "<!-- $marker -->" "$plist" 2>/dev/null; then
        if [ "$check_only" -eq 1 ]; then
            printf '  %-28s %-18s %s\n' "$label" retired 'REFUSE — not ours to remove'
            return 0
        fi
        die "refusing to remove a retired service this installer does not own: $plist"
    fi

    if [ "$check_only" -eq 1 ]; then
        printf '  %-28s %-18s %s\n' "$label" retired 'would boot out and remove owned plist'
        return 0
    fi

    if launchctl_available && "$launchctl_bin" print "$target" >/dev/null 2>&1; then
        "$launchctl_bin" bootout "$target" >/dev/null 2>&1 ||
            die "failed to stop retired service $label"
        local waited=0
        while "$launchctl_bin" print "$target" >/dev/null 2>&1 && [ "$waited" -lt 30 ]; do
            sleep 0.2
            waited=$((waited + 1))
        done
        ! "$launchctl_bin" print "$target" >/dev/null 2>&1 ||
            die "retired service remained loaded after bootout: $label"
    fi

    rm -- "$plist"
    note "removed retired owned service $label"
}

status_services() {
    local failures=0 entry label tool log_name lifecycle program plist target
    local ownership service state pid last_exit log log_bytes
    printf 'Fleet launch service status (%s):\n' "$launch_agents_dir"
    for entry in "${SERVICES[@]}"; do
        label="$(field "$entry" 1)"
        tool="$(field "$entry" 2)"
        log_name="$(field "$entry" 3)"
        lifecycle="$(field "$entry" 4)"
        program="$bin_dir/$tool"
        plist="$launch_agents_dir/$label.plist"
        log="$state_root/$tool/$log_name"
        if [ ! -x "$program" ]; then
            printf '  %-42s %-15s %s\n' "$label" skipped "no $program"
            continue
        fi
        ownership="$(plist_ownership "$label")"
        if [ "$ownership" = absent ] && [ "$label" = io.arthack.agentbrain.share ]; then
            printf '  %-42s %-15s %s\n' "$label" optional 'not configured'
            continue
        fi
        if [ "$ownership" != ours ]; then
            printf '  %-42s %-15s ownership=%s\n' "$label" FAIL "$ownership"
            failures=$((failures + 1))
            continue
        fi
        if ! launchctl_available; then
            printf '  %-42s %-15s %s\n' "$label" unknown 'launchctl unavailable'
            failures=$((failures + 1))
            continue
        fi
        target="gui/$(id -u)/$label"
        if ! service=$("$launchctl_bin" print "$target" 2>/dev/null); then
            printf '  %-42s %-15s %s\n' "$label" FAIL 'not loaded'
            failures=$((failures + 1))
            continue
        fi
        state=$(printf '%s\n' "$service" | sed -n 's/^[[:space:]]*state = //p' | sed -n '1p')
        pid=$(printf '%s\n' "$service" | sed -n 's/^[[:space:]]*pid = //p' | sed -n '1p')
        last_exit=$(printf '%s\n' "$service" | sed -n 's/^[[:space:]]*last exit code = //p' | sed -n '1p')
        log_bytes=0
        if [ -f "$log" ]; then
            log_bytes=$(stat -f %z "$log" 2>/dev/null || stat -c %s "$log" 2>/dev/null || printf 0)
        fi
        if [ "$lifecycle" = resident ] && [ "$state" != running ]; then
            printf '  %-42s %-15s state=%s last_exit=%s log_bytes=%s\n' \
                "$label" FAIL "${state:-unknown}" "${last_exit:-unknown}" "$log_bytes"
            failures=$((failures + 1))
        elif [ -n "$last_exit" ] && [ "$last_exit" != 0 ] && [ "$last_exit" != '(never exited)' ]; then
            printf '  %-42s %-15s state=%s pid=%s last_exit=%s log_bytes=%s\n' \
                "$label" FAIL "${state:-unknown}" "${pid:--}" "$last_exit" "$log_bytes"
            failures=$((failures + 1))
        else
            printf '  %-42s %-15s state=%s pid=%s last_exit=%s log_bytes=%s\n' \
                "$label" ok "${state:-unknown}" "${pid:--}" "${last_exit:-unknown}" "$log_bytes"
        fi
    done
    return "$failures"
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --install) check_only=0; status_only=0 ;;
        --check) check_only=1; status_only=0 ;;
        --status) check_only=0; status_only=1 ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
    shift
done

[ -d "$source_dir" ] || die "missing template directory: $source_dir"

if [ "$status_only" -eq 1 ]; then
    status_services
    exit $?
fi

if [ "$check_only" -eq 1 ]; then
    printf 'Fleet launch agents (%s):\n' "$launch_agents_dir"
else
    mkdir -p "$launch_agents_dir"
    chmod 700 "$launch_agents_dir"
fi

retire_agentweb_broker

for entry in "${SERVICES[@]}"; do
    install_service "$entry"
done
