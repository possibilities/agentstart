#!/bin/bash

set -euo pipefail

die() {
    printf 'agentmux-config: %s\n' "$*" >&2
    exit 1
}

# Resolve through any command link so the checkout that performed the install
# remains the source of truth.
script_path="$0"
while [ -L "$script_path" ]; do
    link_target=$(readlink "$script_path")
    case "$link_target" in
        /*) script_path="$link_target" ;;
        *) script_path="$(dirname -- "$script_path")/$link_target" ;;
    esac
done
script_dir=$(cd -P -- "$(dirname -- "$script_path")" && pwd)
repo_root=$(cd -P -- "$script_dir/.." && pwd)

config_source="${AGENTSTART_AGENTMUX_CONFIG_SOURCE:-$repo_root/config/agentmux/instances/default}"
config_target="${AGENTSTART_AGENTMUX_CONFIG_TARGET:-${XDG_CONFIG_HOME:-$HOME/.config}/agentmux/instances/default}"

install_config() {
    [ -s "$config_source" ] \
        || die "agentmux instance config is missing or empty: $config_source"
    if [ ! -L "$config_target" ] && [ -e "$config_target" ]; then
        die "refusing to replace independent agentmux instance config: $config_target"
    fi

    mkdir -p -- "$(dirname -- "$config_target")"
    ln -sfn -- "$config_source" "$config_target"
    [ -L "$config_target" ] \
        || die "agentmux instance config target is not a link: $config_target"
    cmp -s -- "$config_source" "$config_target" \
        || die "linked agentmux instance config does not resolve to $config_source: $config_target"
}

usage() {
    cat <<'EOF'
Usage: agentmux-config <command>

Commands:
  install   Link AgentStart's agentmux instance config into the XDG config directory
EOF
}

case "${1:-}" in
    install)
        [ "$#" -eq 1 ] || die "install takes no arguments"
        install_config
        ;;
    -h|--help)
        usage
        ;;
    *)
        usage >&2
        exit 64
        ;;
esac
