#!/usr/bin/env bun
// Internal shim helper: codex-invocation <native-codex> [native arguments...].
// Keep CODEX_HOME, auth, history, account selection, stdio and CLI precedence.
import { closeSync, existsSync, lstatSync, mkdirSync, openSync, readFileSync, realpathSync, statSync, unlinkSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { dirname, join, resolve } from "node:path";
import { spawn } from "node:child_process";
import { randomUUID } from "node:crypto";
import { captureEdits, notify, registerNativeHome, resolvePreferences } from "./harness-config.ts";

const commands = new Set([
  "agents", "exec", "e", "review", "login", "logout", "mcp", "plugin", "mcp-server",
  "app-server", "remote-control", "app", "completion", "update", "doctor", "sandbox",
  "debug", "apply", "resume", "queue", "archive", "delete", "migrate-rollouts",
  "unarchive", "fork", "cloud", "exec-server", "features", "help",
]);
const runtimeCommands = new Set(["exec", "e", "review", "resume", "fork"]);
// Arity matters: a model, config value, title, or prompt can itself say "login"
// or "--cd". Never parse past the native -- argument delimiter.
const valueOptions = new Set([
  "-c", "--config", "-m", "--model", "-p", "--profile", "-C", "--cd",
  "-i", "--image", "-s", "--sandbox", "-a", "--ask-for-approval",
  "--enable", "--disable", "--remote", "--remote-auth-token-env", "--local-provider",
  "--add-dir", "--thread-source", "--output-schema", "--color", "-o",
  "--output-last-message", "--base", "--commit", "--title",
]);

export function inspect(args) {
  let command = null, positional = false, execSubcommand = false, cd = null, profile = null, bypass = false;
  const forwarded = [], overrides = [];
  for (let i = 0; i < args.length; i++) {
    const token = args[i];
    if (token === "--") { forwarded.push(...args.slice(i)); break; }
    if (!token.startsWith("-")) {
      if (!positional) {
        if (commands.has(token)) command = token;
        execSubcommand = command === "exec" || command === "e";
        positional = true;
      } else if (execSubcommand) {
        if (token === "help") bypass = true;
        execSubcommand = false;
      }
      forwarded.push(token);
      continue;
    }
    let option = token, value, consumed = 0;
    if (token.startsWith("--") && token.includes("=")) {
      const split = token.indexOf("="); option = token.slice(0, split); value = token.slice(split + 1);
    } else if (!token.startsWith("--") && token.length > 2 && valueOptions.has(token.slice(0, 2))) {
      option = token.slice(0, 2); value = token.slice(2).replace(/^=/, "");
    } else if (valueOptions.has(option)) {
      if (i + 1 === args.length) return { bypass: true, args };
      value = args[i + 1]; consumed = 1;
    }
    if (["--help", "-h", "--version", "-V", "--remote", "--ignore-user-config"].includes(option)) bypass = true;
    if (option === "--cd" || option === "-C") cd = value;
    if (option === "--config" || option === "-c") overrides.push(value);
    if (option === "--profile" || option === "-p") {
      if (profile !== null) throw new Error("only one --profile may be selected");
      profile = value;
    } else forwarded.push(...args.slice(i, i + consumed + 1));
    i += consumed;
  }
  return { bypass: bypass || (command !== null && !runtimeCommands.has(command)), args: forwarded, cd, profile, overrides };
}

function table(value) { return value !== null && typeof value === "object" && !Array.isArray(value) && !(value instanceof Date); }
export function merge(base, overlay) {
  const result = { ...base };
  for (const [key, value] of Object.entries(overlay)) {
    Object.defineProperty(result, key, { value: table(value) && table(result[key]) ? merge(result[key], value) : value,
      enumerable: true, configurable: true, writable: true });
  }
  return result;
}
function readConfig(path) {
  try { return Bun.TOML.parse(readFileSync(path, "utf8")); }
  catch { throw new Error(`cannot read valid TOML from ${path}`); }
}
export function projectRoot(cwd, markers) {
  if (!Array.isArray(markers) || !markers.every(m => typeof m === "string" && m.length > 0 && !m.includes("/"))) {
    throw new Error("project_root_markers must be an array of directory-entry names");
  }
  for (let dir = cwd; ; dir = dirname(dir)) {
    if (markers.some(marker => existsSync(join(dir, marker)))) return dir;
    if (dirname(dir) === dir) return cwd;
  }
}

async function main() {
  const [binary, ...original] = process.argv.slice(2);
  if (!binary) throw new Error("usage: codex-invocation <native-codex> [native arguments...]");
  const parsed = inspect(original);
  const customSource = process.env.AGENTSTART_CODEX_CONFIG_SOURCE;
  const source = customSource || (parsed.bypass ? "" : resolvePreferences("codex"));
  let profilePath = null;
  let authored, baseline;
  let args = original;
  let child;
  const signals = { SIGHUP: 129, SIGINT: 130, SIGQUIT: 131, SIGTERM: 143 };
  const handlers = new Map();
  // The native TUI shares our foreground process group and receives terminal
  // SIGINT/SIGQUIT itself. Forward non-terminal interrupts and parent-only
  // termination without detaching or piping its terminal.
  for (const signal of Object.keys(signals)) {
    const handler = () => {
      if (process.stdin.isTTY && (signal === "SIGINT" || signal === "SIGQUIT")) return;
      child?.kill(signal);
    };
    handlers.set(signal, handler); process.on(signal, handler);
  }
  try {
    // Missing optional Funk checkout/config is a pass-through. An explicitly
    // selected source, or a present but unreadable/malformed source, must fail.
    if (!parsed.bypass && (lstatSync(source, { throwIfNoEntry: false }) || process.env.AGENTSTART_CODEX_CONFIG_SOURCE)) {
      const codexHome = resolve(process.env.CODEX_HOME || join(homedir(), ".codex"));
      let config = readConfig(source);
      authored = config;
      for (const key of ["projects", "profile", "profiles"]) {
        if (Object.hasOwn(config, key)) throw new Error(`${key} is runtime state; remove it from ${source}`);
      }
      if (parsed.profile !== null) {
        if (!/^[a-zA-Z0-9_-]+$/.test(parsed.profile)) throw new Error("invalid native profile name");
        config = merge(config, readConfig(join(codexHome, `${parsed.profile}.config.toml`)));
      }
      const cwd = realpathSync(resolve(parsed.cd ?? process.cwd()));
      if (!statSync(cwd).isDirectory()) throw new Error(`working directory is not a directory: ${cwd}`);
      const basePath = join(codexHome, "config.toml");
      if (!customSource) registerNativeHome("codex", basePath);
      const base = existsSync(basePath) ? readConfig(basePath) : {};
      let markers = config.project_root_markers ?? base.project_root_markers ?? [".git"];
      for (const override of parsed.overrides) {
        if (/^project_root_markers\s*=/.test(override)) markers = Bun.TOML.parse(override).project_root_markers;
      }
      config = merge(config, { projects: {
        [cwd]: { trust_level: "trusted" },
        [projectRoot(cwd, markers)]: { trust_level: "trusted" },
      } });
      mkdirSync(codexHome, { recursive: true, mode: 0o700 });
      const name = `agentstart-invocation-${randomUUID()}`;
      const path = join(codexHome, `${name}.config.toml`);
      args = ["--profile", name, ...parsed.args];
      // Exclusive creation and unique names isolate simultaneous processes.
      const rendered = Bun.TOML.stringify(config);
      baseline = config;
      const fd = openSync(path, "wx", 0o600);
      profilePath = path;
      try { writeFileSync(fd, rendered); }
      finally { closeSync(fd); }
    }
    return await new Promise((resolveExit, reject) => {
      child = spawn(binary, args, { stdio: "inherit" });
      child.once("error", reject);
      child.once("exit", (code, signal) => resolveExit(code ?? signals[signal] ?? 1));
    });
  } finally {
    for (const [signal, handler] of handlers) process.off(signal, handler);
    if (profilePath) {
      try {
        if (!customSource && existsSync(profilePath)) captureEdits("codex", baseline, readConfig(profilePath), authored, undefined, profilePath);
      } catch {
        // Preserve the private profile if it cannot be inspected. Never erase
        // potentially deliberate edits just because parsing/capture failed.
        console.error(`codex-invocation: cannot capture preference edits; retained ${profilePath} for review`);
        await notify([{ harness: "codex", kind: "attention", message: `Codex preference capture failed. Retained profile for review: ${profilePath}` }]);
        profilePath = null;
      }
      if (profilePath && existsSync(profilePath)) unlinkSync(profilePath);
    }
  }
}

if (import.meta.main) {
  try { process.exitCode = await main(); }
  catch (error) { console.error(`codex-invocation: ${error.message}`); process.exitCode = 1; }
}
