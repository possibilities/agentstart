#!/bin/bash
# Shared installer for fleet convergence and AgentNotify's explicit setup action.
set -euo pipefail
die() { printf 'AgentStart notification shim installer: %s\n' "$*" >&2; exit 1; }
[ "$#" -eq 0 ] || die 'no arguments are supported'
[ "$(uname -s)" = Darwin ] || die 'macOS is required'
[ "$(id -u)" -ne 0 ] || die 'run as the target user, not root'
script_dir=$(cd -P -- "$(dirname -- "$0")" && pwd)
source_shim="$script_dir/../config/notifications/terminal-notifier"
bin_dir="${AGENTSTART_INSTALL_BIN_DIR:-$HOME/.local/bin}"
target="$bin_dir/terminal-notifier"
primary="$bin_dir/agentnotify"
marker='# agentstart-installer-owned: terminal-notifier.router.v1'
for directory in "$HOME/.local" "$bin_dir"; do
    [ ! -L "$directory" ] || die "refusing a symlinked installation directory: $directory"
done
# A linked Homebrew notifier can bypass the managed PATH router from launchd
# or an absolute-path caller. Require its removal before installing the shim;
# aliases of the managed router or AgentNotify itself are harmless.
prefixes="${AGENTSTART_TERMINAL_NOTIFIER_PREFIXES:-/opt/homebrew:/usr/local}"
old_ifs=$IFS
IFS=:
for prefix in $prefixes; do
    candidate="$prefix/bin/terminal-notifier"
    if [ -n "$prefix" ] && [ -x "$candidate" ] \
        && { [ ! -e "$target" ] || [ ! "$candidate" -ef "$target" ]; } \
        && { [ ! -e "$primary" ] || [ ! "$candidate" -ef "$primary" ]; }; then
        IFS=$old_ifs
        die "Homebrew terminal-notifier is still installed at $candidate. Uninstall it with brew uninstall terminal-notifier, then install the shim. Otherwise launchd and scripts keep posting macOS banners."
    fi
done
IFS=$old_ifs
if [ -L "$target" ]; then
    # Migrate only the exact compatibility link made by AgentNotify's installer.
    [ "$(readlink "$target")" = "$HOME/Applications/AgentNotify.app/Contents/MacOS/AgentNotify" ] \
        || die "refusing an independent symlink: $target"
elif [ -e "$target" ]; then
    if [ ! -f "$target" ] || ! grep -Fxq "$marker" "$target"; then
        die "refusing an independent command: $target"
    fi
fi
mkdir -p "$bin_dir"
temporary=$(mktemp "$bin_dir/.terminal-notifier.XXXXXX")
trap 'rm -f -- "$temporary"' EXIT
install -m 0755 "$source_shim" "$temporary"
mv -f -- "$temporary" "$target"
printf 'Installed AgentNotify-only terminal-notifier router: %s.\n' "$target"
