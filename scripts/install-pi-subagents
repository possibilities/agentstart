#!/bin/bash

set -euo pipefail

# The Pi subagent capability. Pi ships no subagents by design — its own README
# says so and points at third-party packages — so the fleet installs one, and
# managed Pi sessions receive it through the fixed private resources rather than
# Pi's ambient discovery directories.
#
# The package is installed here, not with `pi install`. A package registered in
# Pi's settings is exactly what a managed launch suppresses: AgentLaunch runs Pi
# with --no-extensions --no-skills --no-prompt-templates and then names every
# resource explicitly. What survives that is an explicit --extension path, and
# AgentLaunch produces one per entry in the pack's pi/extensions directory.
#
# Point Pi at the package DIRECTORY, never at index.ts. A directory carrying a
# package.json "pi" manifest registers the extension, its skills, and its
# workflow prompt templates from that one path; index.ts alone loads the
# extension and silently drops the other two.
#
# The directory must also be self-contained. Pi never runs npm for a local path,
# and AgentLaunch projects an entry by copying its own subtree, so hoisted
# dependencies outside the package would be left behind and Pi would fail at
# load with "Cannot find module 'yaml'". `npm install` runs inside the extracted
# package for exactly that reason.
pinned_version=0.55.0
package_name=pi-subagents

die() {
    printf 'AgentStart pi-subagents: %s\n' "$*" >&2
    exit 1
}

usage() {
    printf 'Usage: install-pi-subagents --install|--check\n'
}

[ "$#" -eq 1 ] || {
    usage >&2
    exit 64
}

install_root="${AGENTSTART_PI_SUBAGENTS_ROOT:-$HOME/.local/share/agentstart/pi-subagents}"
package_root="$install_root/$package_name"

case "$1" in
    --install) ;;
    --check)
        cat <<EOF
  npm pack $package_name@$pinned_version, extracted with its runtime dependencies to $package_root
  # pinned: Pi skips versioned specs when it updates extensions, so the pin is also the upgrade gate
  # the fixed resources carry this directory; AgentLaunch names it with --extension
EOF
        exit 0
        ;;
    -h|--help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 64
        ;;
esac

[ "$(uname -s)" = Darwin ] || die "macOS is required"
[ "$(id -u)" -ne 0 ] || die "run as the target user, not root"
command -v npm >/dev/null 2>&1 || die "npm is required to install $package_name"

installed_version=''
if [ -f "$package_root/package.json" ]; then
    installed_version=$(
        /usr/bin/env node -e \
            'process.stdout.write(require(process.argv[1]).version ?? "")' \
            "$package_root/package.json" 2>/dev/null || true
    )
fi

# Rerunnability is a requirement of every installer here, and this one is the
# slowest step by far, so a matching pin with its dependencies already present
# is a no-op rather than a re-download.
if [ "$installed_version" = "$pinned_version" ] && [ -d "$package_root/node_modules" ]; then
    printf 'Pi subagents %s is already installed: %s.\n' "$pinned_version" "$package_root"
    exit 0
fi

printf 'Installing Pi subagents %s.\n' "$pinned_version"
mkdir -p "$install_root"
staging=$(mktemp -d "$install_root/.install.XXXXXX")
trap 'rm -rf -- "$staging"' EXIT

tarball=$(cd "$staging" && npm pack "$package_name@$pinned_version" --silent) \
    || die "downloading $package_name@$pinned_version failed"
[ -f "$staging/$tarball" ] || die "npm pack produced no tarball for $package_name@$pinned_version"

mkdir -p "$staging/package"
tar -xzf "$staging/$tarball" -C "$staging" \
    || die "extracting $tarball failed"
[ -f "$staging/package/package.json" ] \
    || die "$package_name@$pinned_version has no package.json"

# --omit=dev keeps the projected copy to the four runtime dependencies. The
# package declares its own entry points, so nothing here needs to know them.
(cd "$staging/package" && npm install --omit=dev --silent --no-audit --no-fund) \
    || die "installing the $package_name runtime dependencies failed"
[ -d "$staging/package/node_modules" ] \
    || die "$package_name installed no runtime dependencies"

rm -rf -- "$package_root"
mv "$staging/package" "$package_root"
printf 'Installed Pi subagents %s: %s.\n' "$pinned_version" "$package_root"
