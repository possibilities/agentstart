#!/bin/bash

set -euo pipefail

die() {
    printf 'AgentStart agent CLIs installer: %s\n' "$*" >&2
    exit 1
}

[ "$#" -eq 0 ] || {
    printf 'Usage: install-agent-clis\n' >&2
    exit 64
}

[ "$(uname -s)" = Darwin ] || die "macOS is required"
[ "$(id -u)" -ne 0 ] || die "run as the target user, not root"

# Each project owns its own hardened installer: frozen dependency install, a
# ~/.local/bin symlink back into the checkout, a deployed-SHA receipt, and its
# own refusal rules for dirty trees and foreign files. AgentStart decides only
# that these CLIs belong on this machine. A machine that has not cloned a
# checkout is a skip, not a failure; a present checkout that fails to install
# is a real error and propagates. Rerunning is safe: the installers are
# fix-forward and relinking repoints the same command.
#
# The fleet root. AGENTSTART_CODE_ROOT relocates it as a unit — the tests point
# it at a fixture tree — but it deliberately does not resolve relative to this
# script: the installer converges the machine, not the checkout it was invoked
# from, and a worktree run must still find the real fleet rather than silently
# skipping every tool.
code_root="${AGENTSTART_CODE_ROOT:-$HOME/code}"

# AgentUsage owns account observation and its daemon independently of the
# native Claude/Codex launches. The full installer invokes
# install-harness-shims after this loop.
#
# Agentscrape uses agent-browser with Stack's local-only provider. Browser
# installation and Hypeman lifecycle belong to Stack's Package API.
# Archived checkouts (Attention, Grok, HUD, Keys, Mux, Sounds, Source, Utils,
# Work) are no longer installer participants.
# AgentVoice needs stock Codex and a C compiler, provisioned by the outer
# installer. Its installer owns the default waiting server and prepares the
# production web build consumed later by AgentStart's resident transcript
# reader. Default full convergence opts into the owned menu app's graceful
# quit/update/reopen
# protocol so a normal running menu does not block the fleet. During a live-call
# cutover, AGENTSTART_PRESERVE_AGENTVOICE_SERVICE=1 selects its supported
# --command-only mode instead, so no menu, call, or service is restarted.
# agentroles follows agentvoice: it runs claude, codex and agentvoice through
# PATH and passes agentvoice --role, but installs nothing for any of them. Its
# own `install` command is a user action that writes Codex plugin state, never
# part of this loop.
# agentacp follows agentroles: its on-demand broker uses the installed Role
# launcher for private OpenCode ACP and AgentStart's opted-in public Devin shim.
# No resident agentacp LaunchAgent is installed here.
# Stack setup consumes codexnk's verified GitHub release installer, builds
# its packages/UI and links its command, without starting or restarting servers.
# Its shared runtime pin must match the outer installer's Codex consumer pin.
# AgentNotify installs the native app and CLI without launching or restarting it.
# install-harness-shims installs the terminal-notifier router afterward.
# Its stdio MCP connects to the app-owned socket and can launch the app on demand.
for tool in agentwiki agentboard agentsearch agentscrape \
    agentbrain agentusage agentvoice agentroles agentacp stack agentnotify; do
    tool_root="$code_root/$tool"
    if [ ! -e "$tool_root" ] && [ ! -L "$tool_root" ]; then
        printf 'AgentStart agent CLIs installer: no checkout at %s; skipping.\n' "$tool_root"
        continue
    fi
    [ -f "$tool_root/scripts/install.sh" ] && [ -x "$tool_root/scripts/install.sh" ] \
        || die "present checkout has no executable installer: $tool_root/scripts/install.sh"
    printf 'Installing %s from %s.\n' "$tool" "$tool_root"
    if [ "$tool" = agentvoice ]; then
        if [ "${AGENTSTART_PRESERVE_AGENTVOICE_SERVICE:-0}" = 1 ]; then
            "$tool_root/scripts/install.sh" --install --command-only
        else
            "$tool_root/scripts/install.sh" --install --quit-menu
        fi
    else
        "$tool_root/scripts/install.sh" --install
    fi
done
