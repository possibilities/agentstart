#!/bin/bash

set -euo pipefail

die() {
    printf 'AgentStart agent CLIs installer: %s\n' "$*" >&2
    exit 1
}

[ "$#" -eq 0 ] || {
    printf 'Usage: install-agent-clis\n' >&2
    exit 64
}

[ "$(uname -s)" = Darwin ] || die "macOS is required"
[ "$(id -u)" -ne 0 ] || die "run as the target user, not root"

# Each project owns its own hardened installer: frozen dependency install, a
# ~/.local/bin symlink back into the checkout, a deployed-SHA receipt, and its
# own refusal rules for dirty trees and foreign files. AgentStart decides only
# that these CLIs belong on this machine. A machine that has not cloned a
# checkout is a skip, not a failure; a present checkout that fails to install
# is a real error and propagates. Rerunning is safe: the installers are
# fix-forward and relinking repoints the same command.
#
# The fleet root. AGENTSTART_CODE_ROOT relocates it as a unit — the tests point
# it at a fixture tree — but it deliberately does not resolve relative to this
# script: the installer converges the machine, not the checkout it was invoked
# from, and a worktree run must still find the real fleet rather than silently
# skipping every tool.
code_root="${AGENTSTART_CODE_ROOT:-$HOME/code}"

# agentusage precedes agentlaunch because the launcher shells its balance
# contract and its installer provisions the public claude-swap fork at its
# `integration` branch — the fleet's fork convention. The shims installer
# refuses without `agentlaunch` on PATH, and the machine's shell configuration
# prefixes the shim directory. Installing the CLI does not install the shims —
# that stays a deliberate `scripts/install-agentlaunch-shims`.
#
# codex-swap and grok-swap own their own commands now, and agentusage does not
# write competing shims for them, so each command has exactly one owner. They
# run before agentusage to keep both provider layers installed before the
# observer that reads them. Codex-swap's own installer binds the exact stock
# codex-multi-auth npm pin; no fork checkout participates in this loop.
#
# Agentscrape no longer consults Agentweb's origin/session conduit. An explicit
# stable session maps through the configured agent-browser provider to an
# Agentbrowse Browser profile, so Agentscrape and Agentbrain have no special
# install-order relationship beyond both preceding their resident services.
#
# agentbrowse-infra precedes agentbrowse because it owns the manual Apple
# lifecycle command referenced by agentbrowse's recovery messages. Installing
# it never enables Apple services or acquires an image. Agentbrowse supplies
# agent-browser's ordered provider. The provider process is short-lived and
# resolves the Browser target's CDP URL dynamically; there is no provider
# service to install or configure with a static URL.
# agentattention follows it because its browser-interaction processor imports
# agentbrowse's supported OpenTUI surface from the adjacent installed checkout.
#
# agentsurface follows agentlaunch: its launcher and its conversation slugs
# both consume the resolved catalog over `agentlaunch x-catalog`.
#
# agentwork follows agentmux: it is a file:../agentmux dependency. It is a
# setup (programs for agentmux's parts), not a command; nothing goes on PATH.
#
# agentgrok has no install-order relationship with any fleet tool. At runtime
# it reads the Grok Build CLI's login and shells out to `grok models` to renew
# it; the `grok` cask is installed by scripts/install.sh, not by this loop.
# AgentVoice needs stock Codex and a C compiler, provisioned by the outer
# installer. Its contract installs only the editable command and native audio;
# it starts no voice session/service and adds no AgentLaunch or skill policy.
#
# agentroles follows agentvoice: it runs claude, codex and agentvoice through
# PATH and passes agentvoice --role, but installs nothing for any of them. Its
# own `install` command is a user action that writes Codex plugin state, never
# part of this loop.
for tool in agentwiki agentboard agentbrowse-infra agentbrowse agentattention agentutils agentsearch agentkeys agentsource agentscrape \
    agentbrain codex-swap grok-swap agentusage agentlaunch agentsurface agentgrok agentvoice agentroles agentmux agentwork; do
    tool_root="$code_root/$tool"
    if [ ! -e "$tool_root" ] && [ ! -L "$tool_root" ]; then
        printf 'AgentStart agent CLIs installer: no checkout at %s; skipping.\n' "$tool_root"
        continue
    fi
    [ -f "$tool_root/scripts/install.sh" ] && [ -x "$tool_root/scripts/install.sh" ] \
        || die "present checkout has no executable installer: $tool_root/scripts/install.sh"
    printf 'Installing %s from %s.\n' "$tool" "$tool_root"
    "$tool_root/scripts/install.sh" --install
done
