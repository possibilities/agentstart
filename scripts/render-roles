#!/usr/bin/env python3
"""Assemble AgentStart's authored roles with their own MCP inventories."""

import hashlib
import json
import os
import re
from pathlib import Path
import runpy
import shutil
import stat
import sys
import tempfile

OWNER = "agentstart-role-v2"
FILTERED_OWNER = "agentstart-role-v3"
SKILL_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]*")
MARKER = ".agentstart-role.json"
PROMPTS = (
    "SYSTEM_PROMPT.md", "APPEND_SYSTEM_PROMPT.md",
    "VOICE_AGENT_SYSTEM_PROMPT.md", "VOICE_AGENT_APPEND_SYSTEM_PROMPT.md",
    "VOICE_ORCHESTRATOR_SYSTEM_PROMPT.md", "VOICE_ORCHESTRATOR_APPEND_SYSTEM_PROMPT.md",
    "VOICE_ORCHESTRATOR_MULTI_AGENT_MODE.md",
    "VOICE_ORCHESTRATOR_SESSION_START.md", "VOICE_ORCHESTRATOR_SESSION_END.md",
)


def inspect_owned(role):
    if not role.exists() and not role.is_symlink():
        return None
    info = role.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o022:
        raise ValueError(f"refusing redirected or foreign role: {role}")
    marker = role / MARKER
    if marker.is_symlink() or not marker.is_file():
        raise ValueError(f"refusing independent role: {role}")
    receipt = json.loads(marker.read_bytes())
    if not isinstance(receipt, dict):
        raise ValueError(f"invalid role ownership: {role}")
    filtered = receipt.get("owner") == FILTERED_OWNER
    fields = {"owner", "links", "mcp_sha256", "skills"} if filtered else {"owner", "links", "mcp_sha256"}
    if receipt.get("owner") not in (OWNER, FILTERED_OWNER) or set(receipt) != fields:
        raise ValueError(f"unrecognized role ownership: {role}")
    links = receipt["links"]
    if not isinstance(links, dict) or any(name not in (*PROMPTS, "skills") for name in links):
        raise ValueError(f"invalid role links: {role}")
    if filtered and "skills" in links:
        raise ValueError(f"filtered role has a shared skills link: {role}")
    expected = {MARKER, "mcp.json", *links} | ({"skills"} if filtered else set())
    if {p.name for p in role.iterdir()} != expected:
        raise ValueError(f"role has independent files: {role}")
    for name, target in links.items():
        path = role / name
        if not path.is_symlink() or os.readlink(path) != target:
            raise ValueError(f"role link changed independently: {path}")
    if filtered:
        skills = receipt["skills"]
        directory = role / "skills"
        entry = directory.lstat()
        if not stat.S_ISDIR(entry.st_mode) or entry.st_uid != os.getuid() or entry.st_mode & 0o022:
            raise ValueError(f"unsafe role skills directory: {directory}")
        if not isinstance(skills, dict) or any(not isinstance(name, str) or not SKILL_NAME.fullmatch(name)
                                               or not isinstance(target, str)
                                               for name, target in skills.items()):
            raise ValueError(f"invalid role skills: {role}")
        if {p.name for p in directory.iterdir()} != set(skills):
            raise ValueError(f"role skills changed independently: {directory}")
        for name, target in skills.items():
            path = directory / name
            if not path.is_symlink() or os.readlink(path) != target:
                raise ValueError(f"role skill link changed independently: {path}")
    mcp = role / "mcp.json"
    for path in (marker, mcp):
        entry = path.lstat()
        if not stat.S_ISREG(entry.st_mode) or entry.st_uid != os.getuid() or entry.st_nlink != 1 or entry.st_mode & 0o022:
            raise ValueError(f"unsafe role file: {path}")
    if hashlib.sha256(mcp.read_bytes()).hexdigest() != receipt["mcp_sha256"]:
        raise ValueError(f"role MCP inventory changed independently: {role}")
    return ((info.st_dev, info.st_ino, info.st_mtime_ns, info.st_ctime_ns), marker.read_bytes())


def prepare(source, resources):
    if source.is_symlink() or not source.is_dir():
        raise ValueError(f"missing or redirected role source: {source}")
    links = {"skills": "../../skills"}
    skills = None
    exclusions = source / "skills-exclude.json"
    if exclusions.exists() or exclusions.is_symlink():
        if exclusions.is_symlink() or not exclusions.is_file():
            raise ValueError(f"invalid skill exclusions: {exclusions}")
        excluded = json.loads(exclusions.read_bytes())
        if not isinstance(excluded, list) or any(not isinstance(name, str) or not SKILL_NAME.fullmatch(name)
                                                  for name in excluded) or len(set(excluded)) != len(excluded):
            raise ValueError(f"invalid skill exclusions: {exclusions}")
        skills = {}
        for skill in sorted((resources / "skills").iterdir()):
            if not skill.is_dir() or not (skill / "SKILL.md").is_file():
                continue
            if not SKILL_NAME.fullmatch(skill.name):
                raise ValueError(f"invalid synchronized skill name: {skill.name}")
            if skill.name not in excluded:
                skills[skill.name] = f"../../../skills/{skill.name}"
        links = {}
    for name in PROMPTS:
        path = source / name
        if path.exists() or path.is_symlink():
            content = path.read_bytes()
            if name == "VOICE_ORCHESTRATOR_MULTI_AGENT_MODE.md" and len(content) > 1600:
                raise ValueError(f"native mode exceeds 1600 UTF-8 bytes: {path}")
            links[name] = str(path)
    if not any(name in links for name in PROMPTS):
        raise ValueError(f"role has no prompts: {source}")
    for base, append in (("SYSTEM_PROMPT.md", "APPEND_SYSTEM_PROMPT.md"),
                         ("VOICE_AGENT_SYSTEM_PROMPT.md", "VOICE_AGENT_APPEND_SYSTEM_PROMPT.md")):
        if base in links and append in links:
            raise ValueError(f"conflicting prompt forms: {source}")
    base = "VOICE_ORCHESTRATOR_SYSTEM_PROMPT.md" if "VOICE_ORCHESTRATOR_SYSTEM_PROMPT.md" in links else "SYSTEM_PROMPT.md"
    append = "VOICE_ORCHESTRATOR_APPEND_SYSTEM_PROMPT.md" if "VOICE_ORCHESTRATOR_APPEND_SYSTEM_PROMPT.md" in links else "APPEND_SYSTEM_PROMPT.md"
    if base in links and append in links:
        raise ValueError(f"conflicting effective prompts: {source}")
    render = runpy.run_path(str(Path(__file__).with_name("render-mcp-resources")))["render"]
    mcp = (json.dumps(render(source / "mcp.json", Path.home()), indent=2) + "\n").encode()
    record = {"owner": OWNER if skills is None else FILTERED_OWNER, "links": links,
              "mcp_sha256": hashlib.sha256(mcp).hexdigest()}
    if skills is not None:
        record["skills"] = skills
    receipt = (json.dumps(record, indent=2) + "\n").encode()
    return links, skills, mcp, receipt


def render(resources, sources):
    if not (resources / "skills").is_dir():
        raise ValueError("synchronized skills must exist before rendering roles")
    parent = resources / "roles"
    if parent.is_symlink():
        raise ValueError(f"refusing redirected role parent: {parent}")
    # Validate both sources and destinations before publishing either role.
    prepared = [(name, prepare(sources / name, resources), inspect_owned(parent / name))
                for name in ("manager", "worker")]
    parent.mkdir(exist_ok=True, mode=0o700)
    for name, (links, skills, mcp, receipt), before in prepared:
        role = parent / name
        if before is not None and before[1] == receipt:
            continue
        stage = Path(tempfile.mkdtemp(prefix=f".{name}.", dir=parent))
        backup = stage.with_name(stage.name + ".previous")
        try:
            for filename, target in links.items():
                (stage / filename).symlink_to(target)
            if skills is not None:
                (stage / "skills").mkdir(mode=0o700)
                for skill_name, target in skills.items():
                    (stage / "skills" / skill_name).symlink_to(target)
            (stage / "mcp.json").write_bytes(mcp)
            (stage / "mcp.json").chmod(0o600)
            (stage / MARKER).write_bytes(receipt)
            (stage / MARKER).chmod(0o600)
            if inspect_owned(role) != before:
                raise ValueError(f"role changed during rendering: {role}")
            if before is not None:
                role.rename(backup)
            try:
                stage.rename(role)
            except OSError:
                if backup.exists():
                    backup.rename(role)
                raise
            if backup.exists():
                shutil.rmtree(backup)
        finally:
            if stage.exists():
                shutil.rmtree(stage)
        print(f"Rendered {name} role at {role}")


if __name__ == "__main__":
    try:
        if len(sys.argv) != 3:
            raise ValueError("Usage: render-roles RESOURCES_ROOT ROLE_SOURCES")
        resources, sources = map(Path, sys.argv[1:])
        if not resources.is_absolute() or not sources.is_absolute():
            raise ValueError("resource and role source paths must be absolute")
        render(resources, sources)
    except (OSError, ValueError, TypeError, KeyError) as error:
        raise SystemExit(f"AgentStart roles: {error}") from error
