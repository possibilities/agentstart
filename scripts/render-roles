#!/usr/bin/env python3
"""Assemble AgentStart's authored default role and retire owned old roles."""

import hashlib
import json
import os
import re
from pathlib import Path
import runpy
import shutil
import stat
import sys
import tempfile

OWNER = "agentstart-role-v2"
FILTERED_OWNER = "agentstart-role-v3"
CONTENT_OWNER = "agentstart-role-v4"
FRAGMENT_OWNER = "agentstart-role-v5"
CONTENT_FORMAT = "agentvoice-role-content-v1"
DOMAIN_FRAGMENT_MARKER = "<!-- fragment: domain-model.md -->"
SKILL_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]*")
MARKER = ".agentstart-role.json"
ROLE = "default"
RETIRED_ROLES = ("manager", "worker")
PROMPTS = (
    "SYSTEM_PROMPT.md", "APPEND_SYSTEM_PROMPT.md",
    "VOICE_AGENT_SYSTEM_PROMPT.md", "VOICE_AGENT_APPEND_SYSTEM_PROMPT.md",
    "VOICE_ORCHESTRATOR_SYSTEM_PROMPT.md", "VOICE_ORCHESTRATOR_APPEND_SYSTEM_PROMPT.md",
    "VOICE_ORCHESTRATOR_MULTI_AGENT_MODE.md",
    "VOICE_ORCHESTRATOR_SESSION_START.md", "VOICE_ORCHESTRATOR_SESSION_END.md",
)


def inspect_owned(role):
    if not role.exists() and not role.is_symlink():
        return None
    info = role.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o022:
        raise ValueError(f"refusing redirected or foreign role: {role}")
    marker = role / MARKER
    if marker.is_symlink() or not marker.is_file():
        raise ValueError(f"refusing independent role: {role}")
    receipt = json.loads(marker.read_bytes())
    if not isinstance(receipt, dict):
        raise ValueError(f"invalid role ownership: {role}")
    owner = receipt.get("owner")
    filtered = owner == FILTERED_OWNER or (owner in (CONTENT_OWNER, FRAGMENT_OWNER) and "skills" in receipt)
    fields = {"owner", "links", "mcp_sha256"}
    if filtered:
        fields.add("skills")
    if owner in (CONTENT_OWNER, FRAGMENT_OWNER):
        fields.add("content")
        if "monitors_sha256" in receipt:
            fields.add("monitors_sha256")
    if owner == FRAGMENT_OWNER:
        fields.add("rendered_prompts")
    if owner not in (OWNER, FILTERED_OWNER, CONTENT_OWNER, FRAGMENT_OWNER) or set(receipt) != fields:
        raise ValueError(f"unrecognized role ownership: {role}")
    if owner in (CONTENT_OWNER, FRAGMENT_OWNER):
        content = receipt["content"]
        digests = {"format", "content", "prompts", "mcp", "skills"}
        if (not isinstance(content, dict) or set(content) != digests
                or content.get("format") != CONTENT_FORMAT
                or any(not isinstance(content.get(name), str)
                       or not re.fullmatch(r"[a-f0-9]{64}", content[name])
                       for name in digests - {"format"})):
            raise ValueError(f"invalid role content receipt: {role}")
    links = receipt["links"]
    if not isinstance(links, dict) or any(name not in (*PROMPTS, "skills") for name in links):
        raise ValueError(f"invalid role links: {role}")
    rendered_prompts = receipt.get("rendered_prompts", {})
    if (not isinstance(rendered_prompts, dict)
            or any(name not in PROMPTS or name in links
                   or not isinstance(digest, str) or not re.fullmatch(r"[a-f0-9]{64}", digest)
                   for name, digest in rendered_prompts.items())):
        raise ValueError(f"invalid rendered role prompts: {role}")
    if filtered and "skills" in links:
        raise ValueError(f"filtered role has a shared skills link: {role}")
    monitored = "monitors_sha256" in receipt
    if monitored and (not isinstance(receipt["monitors_sha256"], str)
                      or not re.fullmatch(r"[a-f0-9]{64}", receipt["monitors_sha256"])):
        raise ValueError(f"invalid role monitor receipt: {role}")
    expected = ({MARKER, "mcp.json", *links, *rendered_prompts}
                | ({"skills"} if filtered else set())
                | ({"monitors.json"} if monitored else set()))
    if {p.name for p in role.iterdir()} != expected:
        raise ValueError(f"role has independent files: {role}")
    for name, target in links.items():
        path = role / name
        if not path.is_symlink() or os.readlink(path) != target:
            raise ValueError(f"role link changed independently: {path}")
    if filtered:
        skills = receipt["skills"]
        directory = role / "skills"
        entry = directory.lstat()
        if not stat.S_ISDIR(entry.st_mode) or entry.st_uid != os.getuid() or entry.st_mode & 0o022:
            raise ValueError(f"unsafe role skills directory: {directory}")
        if not isinstance(skills, dict) or any(not isinstance(name, str) or not SKILL_NAME.fullmatch(name)
                                               or not isinstance(target, str)
                                               for name, target in skills.items()):
            raise ValueError(f"invalid role skills: {role}")
        if {p.name for p in directory.iterdir()} != set(skills):
            raise ValueError(f"role skills changed independently: {directory}")
        for name, target in skills.items():
            path = directory / name
            if not path.is_symlink() or os.readlink(path) != target:
                raise ValueError(f"role skill link changed independently: {path}")
    mcp = role / "mcp.json"
    for path in (marker, mcp, *((role / name) for name in rendered_prompts),
                 *((role / "monitors.json",) if monitored else ())):
        entry = path.lstat()
        if not stat.S_ISREG(entry.st_mode) or entry.st_uid != os.getuid() or entry.st_nlink != 1 or entry.st_mode & 0o022:
            raise ValueError(f"unsafe role file: {path}")
    if hashlib.sha256(mcp.read_bytes()).hexdigest() != receipt["mcp_sha256"]:
        raise ValueError(f"role MCP inventory changed independently: {role}")
    for name, digest in rendered_prompts.items():
        if hashlib.sha256((role / name).read_bytes()).hexdigest() != digest:
            raise ValueError(f"rendered role prompt changed independently: {role / name}")
    if monitored and hashlib.sha256((role / "monitors.json").read_bytes()).hexdigest() != receipt["monitors_sha256"]:
        raise ValueError(f"role monitors changed independently: {role}")
    return ((info.st_dev, info.st_ino, info.st_mtime_ns, info.st_ctime_ns), marker.read_bytes())


def role_content(source, resources, links, rendered_prompts, skills, mcp):
    """Match AgentVoice's directory-role v1 content framing without exposing bytes."""
    entries = []
    total_bytes = 0

    def add_file(logical, path=None, content=None):
        nonlocal total_bytes
        data = content if content is not None else path.read_bytes()
        total_bytes += len(data)
        if total_bytes > 32 * 1024 * 1024 or len(entries) >= 4096:
            raise ValueError("role content observation limit exceeded")
        entry = {"path": logical, "kind": "file", "hash": hashlib.sha256(data).hexdigest()}
        if path is not None and logical.startswith("skills/"):
            entry["executable"] = bool(path.stat().st_mode & 0o111)
        entries.append(entry)

    def walk(logical, path, ancestors):
        real = path.resolve(strict=True)
        info = real.stat()
        if real.is_dir():
            identity = (info.st_dev, info.st_ino)
            if identity in ancestors or len(ancestors) >= 64 or len(entries) >= 4096:
                raise ValueError("role content directory cycle or limit exceeded")
            entries.append({"path": logical, "kind": "directory"})
            next_ancestors = ancestors | {identity}
            for child in sorted(real.iterdir(), key=lambda item: item.name.encode("utf-16-be")):
                walk(f"{logical}/{child.name}", child, next_ancestors)
        elif real.is_file() and info.st_size + total_bytes <= 32 * 1024 * 1024:
            add_file(logical, real)
        else:
            raise ValueError("role content type or size limit exceeded")

    for name in PROMPTS:
        if name in links:
            add_file(name, source / name)
        elif name in rendered_prompts:
            add_file(name, content=rendered_prompts[name])
    add_file("mcp.json", content=mcp)
    entries.append({"path": "skills", "kind": "directory"})
    if skills is None:
        skill_names = [path.name for path in (resources / "skills").iterdir()]
    else:
        skill_names = list(skills)
    for name in sorted(skill_names, key=lambda value: value.encode("utf-16-be")):
        walk(f"skills/{name}", resources / "skills" / name, set())

    entries.sort(key=lambda entry: entry["path"].encode("utf-16-be"))

    def digest(selected):
        framed = json.dumps([CONTENT_FORMAT, selected], ensure_ascii=False,
                            separators=(",", ":")).encode()
        return hashlib.sha256(framed).hexdigest()

    return {
        "format": CONTENT_FORMAT,
        "content": digest(entries),
        "prompts": digest([entry for entry in entries
                           if entry["path"] != "mcp.json"
                           and entry["path"] != "skills"
                           and not entry["path"].startswith("skills/")]),
        "mcp": digest([entry for entry in entries if entry["path"] == "mcp.json"]),
        "skills": digest([entry for entry in entries
                          if entry["path"] == "skills"
                          or entry["path"].startswith("skills/")]),
    }


def prepare(source, resources, fragments=None):
    if source.is_symlink() or not source.is_dir():
        raise ValueError(f"missing or redirected role source: {source}")
    links = {"skills": "../../skills"}
    rendered_prompts = {}
    skills = None
    exclusions = source / "skills-exclude.json"
    if exclusions.exists() or exclusions.is_symlink():
        if exclusions.is_symlink() or not exclusions.is_file():
            raise ValueError(f"invalid skill exclusions: {exclusions}")
        excluded = json.loads(exclusions.read_bytes())
        if not isinstance(excluded, list) or any(not isinstance(name, str) or not SKILL_NAME.fullmatch(name)
                                                  for name in excluded) or len(set(excluded)) != len(excluded):
            raise ValueError(f"invalid skill exclusions: {exclusions}")
        skills = {}
        for skill in sorted((resources / "skills").iterdir()):
            if not skill.is_dir() or not (skill / "SKILL.md").is_file():
                continue
            if not SKILL_NAME.fullmatch(skill.name):
                raise ValueError(f"invalid synchronized skill name: {skill.name}")
            if skill.name not in excluded:
                skills[skill.name] = f"../../../skills/{skill.name}"
        links = {}
    for name in PROMPTS:
        path = source / name
        if path.exists() or path.is_symlink():
            content = path.read_bytes()
            if name == "VOICE_ORCHESTRATOR_MULTI_AGENT_MODE.md" and len(content) > 1600:
                raise ValueError(f"native mode exceeds 1600 UTF-8 bytes: {path}")
            if name == "APPEND_SYSTEM_PROMPT.md" and DOMAIN_FRAGMENT_MARKER.encode() in content:
                if fragments is None:
                    raise ValueError(f"domain fragment root is required for {path}")
                if content.count(DOMAIN_FRAGMENT_MARKER.encode()) != 1:
                    raise ValueError(f"domain fragment marker must occur once: {path}")
                fragment = (fragments / "domain-model.md").read_bytes().strip()
                if not fragment:
                    raise ValueError(f"empty domain fragment: {fragments / 'domain-model.md'}")
                rendered_prompts[name] = content.replace(DOMAIN_FRAGMENT_MARKER.encode(), fragment)
            else:
                links[name] = str(path)
    present = set(links) | set(rendered_prompts)
    if not any(name in present for name in PROMPTS):
        raise ValueError(f"role has no prompts: {source}")
    for base, append in (("SYSTEM_PROMPT.md", "APPEND_SYSTEM_PROMPT.md"),
                         ("VOICE_AGENT_SYSTEM_PROMPT.md", "VOICE_AGENT_APPEND_SYSTEM_PROMPT.md")):
        if base in present and append in present:
            raise ValueError(f"conflicting prompt forms: {source}")
    base = "VOICE_ORCHESTRATOR_SYSTEM_PROMPT.md" if "VOICE_ORCHESTRATOR_SYSTEM_PROMPT.md" in present else "SYSTEM_PROMPT.md"
    append = "VOICE_ORCHESTRATOR_APPEND_SYSTEM_PROMPT.md" if "VOICE_ORCHESTRATOR_APPEND_SYSTEM_PROMPT.md" in present else "APPEND_SYSTEM_PROMPT.md"
    if base in present and append in present:
        raise ValueError(f"conflicting effective prompts: {source}")
    render = runpy.run_path(str(Path(__file__).with_name("render-mcp-resources")))["render"]
    mcp = (json.dumps(render(source / "mcp.json", Path.home()), indent=2) + "\n").encode()
    monitors = None
    path = source / "monitors.json"
    if path.exists() or path.is_symlink():
        if path.is_symlink() or not path.is_file() or path.stat().st_size > 1024 * 1024:
            raise ValueError(f"invalid role monitor source: {path}")
        monitors = path.read_bytes()
        values = json.loads(monitors)
        if (not isinstance(values, list) or len(values) > 32
                or any(not isinstance(entry, dict)
                       or set(entry) - {"name", "command", "description", "when"}
                       or any(not isinstance(entry.get(key), str) or not entry[key].strip()
                              for key in ("name", "command"))
                       or not isinstance(entry.get("description"), str)
                       or ("when" in entry and (not isinstance(entry["when"], str)
                           or (entry["when"] != "always" and not re.fullmatch(r"on-skill-invoke:.+", entry["when"]))))
                       or "${user_config." in entry["command"]
                       for entry in values)
                or len({entry["name"] for entry in values}) != len(values)):
            raise ValueError(f"invalid native monitor array: {path}")
    record = {"owner": FRAGMENT_OWNER if rendered_prompts else CONTENT_OWNER, "links": links,
              "mcp_sha256": hashlib.sha256(mcp).hexdigest(),
              "content": role_content(source, resources, links, rendered_prompts, skills, mcp)}
    if rendered_prompts:
        record["rendered_prompts"] = {
            name: hashlib.sha256(content).hexdigest()
            for name, content in rendered_prompts.items()
        }
    # Additive ownership evidence, not a change to AgentVoice's v1 framing. Its
    # content readers still observe only the prompt/MCP/skills they consume.
    if monitors is not None:
        record["monitors_sha256"] = hashlib.sha256(monitors).hexdigest()
    if skills is not None:
        record["skills"] = skills
    receipt = (json.dumps(record, indent=2) + "\n").encode()
    return links, rendered_prompts, skills, mcp, monitors, receipt


def render(resources, sources, fragments=None):
    if not (resources / "skills").is_dir():
        raise ValueError("synchronized skills must exist before rendering roles")
    parent = resources / "roles"
    if parent.is_symlink():
        raise ValueError(f"refusing redirected role parent: {parent}")
    # Validate the source and every destination before publishing or retiring
    # anything. Old generated roles are removable only while their receipts and
    # content still prove AgentStart ownership.
    prepared = prepare(sources / ROLE, resources, fragments)
    before = {name: inspect_owned(parent / name)
              for name in (ROLE, *RETIRED_ROLES)}
    parent.mkdir(exist_ok=True, mode=0o700)
    links, rendered_prompts, skills, mcp, monitors, receipt = prepared
    role = parent / ROLE
    publish = before[ROLE] is None or before[ROLE][1] != receipt
    retire = [name for name in RETIRED_ROLES if before[name] is not None]
    if not publish and not retire:
        return

    transaction = Path(tempfile.mkdtemp(prefix=".roles.", dir=parent))
    stage = transaction / f"{ROLE}.next"
    moved = []
    installed = False
    committed = False
    try:
        if publish:
            stage.mkdir(mode=0o700)
            for filename, target in links.items():
                (stage / filename).symlink_to(target)
            for filename, content in rendered_prompts.items():
                (stage / filename).write_bytes(content)
                (stage / filename).chmod(0o600)
            if skills is not None:
                (stage / "skills").mkdir(mode=0o700)
                for skill_name, target in skills.items():
                    (stage / "skills" / skill_name).symlink_to(target)
            (stage / "mcp.json").write_bytes(mcp)
            (stage / "mcp.json").chmod(0o600)
            if monitors is not None:
                (stage / "monitors.json").write_bytes(monitors)
                (stage / "monitors.json").chmod(0o600)
            (stage / MARKER).write_bytes(receipt)
            (stage / MARKER).chmod(0o600)

        for name, observation in before.items():
            if inspect_owned(parent / name) != observation:
                raise ValueError(f"role changed during rendering: {parent / name}")

        for name in ((ROLE,) if publish else ()) + tuple(retire):
            source = parent / name
            if before[name] is not None:
                backup = transaction / f"{name}.previous"
                source.rename(backup)
                moved.append((source, backup))
        if publish:
            stage.rename(role)
            installed = True
        committed = True
        shutil.rmtree(transaction)
    except BaseException:
        if not committed:
            if installed and role.exists():
                shutil.rmtree(role)
            for destination, backup in reversed(moved):
                if backup.exists():
                    backup.rename(destination)
        raise
    finally:
        if transaction.exists():
            shutil.rmtree(transaction)

    if publish:
        print(f"Rendered {ROLE} role at {role}")
    for name in retire:
        print(f"Removed retired {name} role at {parent / name}")


if __name__ == "__main__":
    try:
        if len(sys.argv) not in (3, 4):
            raise ValueError("Usage: render-roles RESOURCES_ROOT ROLE_SOURCES [FRAGMENTS_ROOT]")
        resources, sources = map(Path, sys.argv[1:3])
        fragments = Path(sys.argv[3]) if len(sys.argv) == 4 else None
        if not resources.is_absolute() or not sources.is_absolute() or (fragments is not None and not fragments.is_absolute()):
            raise ValueError("resource, role source and fragment paths must be absolute")
        render(resources, sources, fragments)
    except (OSError, ValueError, TypeError, KeyError) as error:
        raise SystemExit(f"AgentStart roles: {error}") from error
