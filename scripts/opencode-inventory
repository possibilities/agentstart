#!/usr/bin/env python3
"""Read OpenCode V2 session metadata without opening messages or changing state."""

import argparse
from contextlib import closing
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import shutil
import sqlite3
import subprocess
import sys
from urllib.parse import quote


REQUIRED_COLUMNS = {
    "id", "title", "parent_id", "directory", "version", "time_created", "time_updated"
}
OPTIONAL_COLUMNS = ("agent", "time_idle", "time_suspended", "time_archived")
KEEPALIVE_PREFIX = "ses_funk_keepalive_v1_"


class InventoryError(Exception):
    pass


def timestamp(milliseconds):
    if milliseconds is None:
        return None
    return datetime.fromtimestamp(milliseconds / 1000, timezone.utc).isoformat().replace("+00:00", "Z")


def default_database():
    data_home = os.environ.get("XDG_DATA_HOME")
    base = Path(data_home).expanduser() if data_home else Path.home() / ".local/share"
    return base / "opencode/opencode.db"


def read_database(path):
    path = path.expanduser().resolve()
    if not path.is_file():
        raise InventoryError(f"OpenCode V2 database unavailable: {path}")
    uri = "file:" + quote(str(path), safe="/") + "?mode=ro"
    try:
        with closing(sqlite3.connect(uri, uri=True, timeout=0.5)) as connection:
            connection.execute("PRAGMA query_only = ON")
            connection.execute("PRAGMA busy_timeout = 500")
            columns = {row[1] for row in connection.execute("PRAGMA table_info(session_v2)")}
            if not columns:
                raise InventoryError(f"session_v2 table missing in {path}")
            missing = sorted(REQUIRED_COLUMNS - columns)
            if missing:
                raise InventoryError(f"unsupported session_v2 schema in {path}: missing {', '.join(missing)}")
            names = sorted(REQUIRED_COLUMNS) + [name for name in OPTIONAL_COLUMNS if name in columns]
            rows = connection.execute(
                "SELECT " + ", ".join(names) + " FROM session_v2"
            ).fetchall()
    except sqlite3.Error as error:
        raise InventoryError(f"cannot read OpenCode V2 database {path}: {type(error).__name__}") from None
    sessions = []
    for values in rows:
        row = dict(zip(names, values))
        archived = row.get("time_archived")
        suspended = row.get("time_suspended")
        idle = row.get("time_idle")
        updated = row["time_updated"]
        # This is a persisted observation, never a claim about live generation.
        recorded_state = (
            "archived" if archived is not None else
            "suspended" if suspended is not None else
            "idle_recorded" if idle is not None and idle >= updated else
            "undetermined"
        )
        sessions.append({
            "id": row["id"],
            "title": row["title"],
            "parent_id": row["parent_id"],
            "directory": row["directory"],
            "version": row["version"],
            "agent": row.get("agent"),
            "created_at": timestamp(row["time_created"]),
            "updated_at": timestamp(updated),
            "idle_at": timestamp(idle),
            "suspended_at": timestamp(suspended),
            "archived_at": timestamp(archived),
            "recorded_state": recorded_state,
            "source_db": str(path),
            "_updated_ms": updated,
        })
    return sessions


def process_inventory():
    ps = shutil.which("ps")
    if not ps:
        return [], "ps unavailable"
    try:
        result = subprocess.run(
            [ps, "-axo", "pid=,ppid=,comm="],
            capture_output=True, text=True, timeout=5, check=True,
        )
    except (OSError, subprocess.SubprocessError):
        return [], "process metadata unavailable"
    processes = []
    lsof = shutil.which("lsof")
    for line in result.stdout.splitlines():
        fields = line.strip().split(None, 2)
        if len(fields) != 3 or Path(fields[2]).name not in ("opencode", "opencode.exe"):
            continue
        try:
            pid, ppid = int(fields[0]), int(fields[1])
        except ValueError:
            continue
        cwd = None
        if lsof:
            try:
                found = subprocess.run(
                    [lsof, "-a", "-p", str(pid), "-d", "cwd", "-Fn"],
                    capture_output=True, text=True, timeout=2, check=True,
                )
                cwd = next((item[1:] for item in found.stdout.splitlines()
                            if item.startswith("n/")), None)
            except (OSError, subprocess.SubprocessError):
                pass
        processes.append({"pid": pid, "ppid": ppid, "executable": fields[2], "cwd": cwd})
    return sorted(processes, key=lambda item: item["pid"]), None


def inventory(args):
    sessions = []
    databases = args.db or [default_database()]
    for path in databases:
        sessions.extend(read_database(path))
    total = len(sessions)
    hidden = 0
    if not args.include_keepalive:
        before = len(sessions)
        sessions = [item for item in sessions if not (
            item["id"].startswith(KEEPALIVE_PREFIX)
            or item["title"] == "Funk OpenCode keepalive (no prompts)"
        )]
        hidden = before - len(sessions)
    if args.roots_only:
        sessions = [item for item in sessions if item["parent_id"] is None]
    if args.directory:
        directory = str(Path(args.directory).expanduser().resolve()).rstrip("/")
        sessions = [item for item in sessions if item["directory"] == directory
                    or item["directory"].startswith(directory + "/")]
    matched = len(sessions)
    sessions.sort(key=lambda item: (-item["_updated_ms"], item["id"], item["source_db"]))
    if args.limit is not None:
        sessions = sessions[:args.limit]
    for item in sessions:
        del item["_updated_ms"]
    processes, warning = process_inventory() if args.processes else ([], None)
    return {
        "observed_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
        "databases": [str(path.expanduser().resolve()) for path in databases],
        "total_records": total,
        "hidden_keepalive": hidden,
        "matched_records": matched,
        "shown_records": len(sessions),
        "sessions": sessions,
        "processes": processes,
        "process_warning": warning,
        "activity_note": "Session rows are persisted metadata; they do not prove a session is currently generating or was generating at process death.",
    }


def print_text(data):
    print(f"OpenCode V2 sessions: {data['shown_records']} shown / {data['matched_records']} matched "
          f"/ {data['total_records']} stored ({data['hidden_keepalive']} keepalive hidden)")
    for item in data["sessions"]:
        print(f"{item['title'] or '(untitled)'}\n"
              f"  id: {item['id']}  parent: {item['parent_id'] or '-'}\n"
              f"  directory: {item['directory']}\n"
              f"  recorded: {item['recorded_state']}  updated: {item['updated_at']}  "
              f"source: {item['source_db']}")
    if data["processes"]:
        print("OpenCode processes (not correlated to individual sessions):")
        for item in data["processes"]:
            print(f"  pid: {item['pid']}  ppid: {item['ppid']}  "
                  f"cwd: {item['cwd'] or '?'}  executable: {item['executable']}")
    if data["process_warning"]:
        print(f"Process observation: {data['process_warning']}", file=sys.stderr)
    print(data["activity_note"])


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--db", type=Path, action="append", help="OpenCode V2 database; repeat for separate stores")
    parser.add_argument("--json", action="store_true", help="print machine-readable inventory")
    parser.add_argument("--include-keepalive", action="store_true", help="include synthetic keepalive records")
    parser.add_argument("--roots-only", action="store_true", help="show only sessions without a parent")
    parser.add_argument("--directory", help="filter to a directory and its descendants")
    parser.add_argument("--limit", type=int, help="show only the newest N matched records")
    parser.add_argument("--processes", action="store_true", help="also list observable OpenCode processes and cwd")
    args = parser.parse_args()
    if args.limit is not None and args.limit < 0:
        parser.error("--limit must be nonnegative")
    try:
        data = inventory(args)
    except InventoryError as error:
        parser.exit(1, f"opencode-inventory: {error}\n")
    if args.json:
        json.dump(data, sys.stdout, indent=2, ensure_ascii=False)
        print()
    else:
        print_text(data)


if __name__ == "__main__":
    main()
