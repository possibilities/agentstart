#!/bin/bash

set -euo pipefail

config_root="${AGENTSTART_HERDR_CONFIG_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/herdr}"

socket_state() {
    local root="$1"
    local sessions_root session_dir socket_path

    if [ ! -e "$root" ] && [ ! -L "$root" ]; then
        return 1
    fi
    [ ! -L "$root" ] && [ -d "$root" ] && [ -r "$root" ] && [ -x "$root" ] \
        || return 2

    socket_path="$root/herdr.sock"
    [ ! -S "$socket_path" ] || return 0
    if [ -e "$socket_path" ] || [ -L "$socket_path" ]; then
        return 2
    fi

    sessions_root="$root/sessions"
    if [ ! -e "$sessions_root" ] && [ ! -L "$sessions_root" ]; then
        return 1
    fi
    [ ! -L "$sessions_root" ] && [ -d "$sessions_root" ] \
        && [ -r "$sessions_root" ] && [ -x "$sessions_root" ] || return 2

    for session_dir in "$sessions_root"/*; do
        if [ ! -e "$session_dir" ] && [ ! -L "$session_dir" ]; then
            continue
        fi
        [ ! -L "$session_dir" ] && [ -d "$session_dir" ] \
            && [ -r "$session_dir" ] && [ -x "$session_dir" ] || return 2

        socket_path="$session_dir/herdr.sock"
        [ ! -S "$socket_path" ] || return 0
        if [ -e "$socket_path" ] || [ -L "$socket_path" ]; then
            return 2
        fi
    done
    return 1
}

state=0
socket_state "$config_root" || state=$?
case "$state" in
    0) printf 'present\n' ;;
    1) printf 'inactive\n' ;;
    *) printf 'uncertain\n' ;;
esac
